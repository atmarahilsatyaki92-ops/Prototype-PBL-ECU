def font(px, bold=False):
    f = QFont("Segoe UI")
    f.setPixelSize(max(8, int(px)))
    f.setBold(bold)
    return f


def card_style(border="#1c2740", width=1):
    return (f"QFrame#card {{ background-color: #0f1624; "
            f"border: {width}px solid {border}; border-radius: 16px; }}")


def chip_style(color):
    c = QColor(color)
    return (f"color: {color}; background-color: rgba({c.red()},{c.green()},{c.blue()},45); "
            "border-radius: 10px; padding: 3px 12px; font-size: 13px; font-weight: bold;")


def load_pixmap(names):
    if isinstance(names, str):
        names = [names]
    for name in names:
        path = os.path.join(BASE_DIR, name)
        if os.path.exists(path):
            pm = QPixmap(path)
            if not pm.isNull():
                return pm
    return None


def make_logo(name, size, white_bg, fallback_text):
    dpr = 2
    pm = QPixmap(size * dpr, size * dpr)
    pm.setDevicePixelRatio(dpr)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    p.setRenderHint(QPainter.SmoothPixmapTransform)

    logo = load_pixmap(name)
    if white_bg:
        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#ffffff"))
        p.drawRoundedRect(QRectF(0, 0, size, size), 18, 18)
    inner = size - 14 if white_bg else size
    if logo:
        sc = logo.scaled(int(inner * dpr), int(inner * dpr), Qt.KeepAspectRatio, Qt.SmoothTransformation)
        sc.setDevicePixelRatio(dpr)
        x = (size - sc.width() / dpr) / 2
        y = (size - sc.height() / dpr) / 2
        p.drawPixmap(QPointF(x, y), sc)
    else:
        p.setPen(QColor("#334155"))
        p.setFont(font(12, True))
        p.drawText(QRectF(0, 0, size, size), Qt.AlignCenter, fallback_text)
    p.end()

    lbl = QLabel()
    lbl.setPixmap(pm)
    lbl.setFixedSize(size, size)
    return lbl


def derive_energy_mode(current, speed, drive_mode, soc, accel_state="HOLD"):
    if drive_mode == "ICE":
        if soc < 20:
            return "SELF_CHARGING"
        elif accel_state == "DECEL":
            return "REGENERATIVE_READY"
        else:
            return "BATTERY_HOLD"
    else:
        if current < -0.5:
            return "CHARGING"
        if current > 0.5 or speed > 0:
            return "DISCHARGING"
        return "IDLE"


def build_view(raw):
    d = dict(raw)
    v = float(d.get("voltage", 0))
    i = float(d.get("current", 0))
    spd = float(d.get("speed", 0))
    dm = d.get("drive_mode", "EV")
    soc = int(max(0, min(100, (v - 60.0) / (84.0 - 60.0) * 100)))
    accel = d.get("accel_state", "HOLD")

    d.setdefault("power", round(v * abs(i) / 1000.0, 2))
    d["soc"] = soc
    d["fuel"] = float(d.get("fuel_level", 85.0))
    d["energy_mode"] = derive_energy_mode(i, spd, dm, soc, accel)
    return d


