class SpeedGauge(QWidget):
    START = 225.0
    SPAN = 270.0

    def __init__(self, parent=None):
        super().__init__(parent)
        self.value = 0.0
        self.setMinimumSize(280, 280)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, v):
        self.value = max(0.0, min(float(MAX_SPEED), v))
        self.update()

    def _pt(self, cx, cy, rad, v):
        a = math.radians(self.START - self.SPAN * v / MAX_SPEED)
        return QPointF(cx + rad * math.cos(a), cy - rad * math.sin(a))

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        s = min(w, h)
        cx, cy = w / 2, h / 2
        pw = s * 0.045
        r = s / 2 - pw / 2 - 4
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1a2336"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, int(self.START * 16), int(-self.SPAN * 16))
        for lo, hi, col in ((ZONE_WARN, ZONE_RED, "#4b3a12"), (ZONE_RED, MAX_SPEED, "#4b1d24")):
            a0 = self.START - self.SPAN * lo / MAX_SPEED
            span = -self.SPAN * (hi - lo) / MAX_SPEED
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.FlatCap))
            p.drawArc(rect, int(a0 * 16), int(span * 16))

        if self.value > 0.5:
            col = RED if self.value >= ZONE_RED else (AMBER if self.value >= ZONE_WARN else CYAN)
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, int(self.START * 16), int(-self.SPAN * (self.value / MAX_SPEED) * 16))

        r_in = r - pw / 2 - s * 0.025
        for v in range(0, MAX_SPEED + 1, 10):
            major = v % 30 == 0
            ln = s * (0.045 if major else 0.025)
            p.setPen(QPen(QColor("#e2e8f0" if major else "#64748b"), 2.2 if major else 1.2))
            p.drawLine(self._pt(cx, cy, r_in, v), self._pt(cx, cy, r_in - ln, v))
            if major:
                lp = self._pt(cx, cy, r_in - s * 0.09, v)
                p.setFont(font(s * 0.042, True))
                p.setPen(QColor("#cbd5e1"))
                p.drawText(QRectF(lp.x() - 24, lp.y() - 12, 48, 24), Qt.AlignCenter, str(v))

        p.setPen(QColor("#64748b"))
        p.setFont(font(s * 0.038, True))
        p.drawText(QRectF(0, cy - s * 0.28, w, s * 0.06), Qt.AlignCenter, "KECEPATAN")
        p.setPen(QColor("#f8fafc"))
        p.setFont(font(s * 0.25, True))
        p.drawText(QRectF(0, cy - s * 0.22, w, s * 0.31), Qt.AlignCenter, str(int(self.value)))
        p.setPen(QColor(GRAY))
        p.setFont(font(s * 0.058, True))
        p.drawText(QRectF(0, cy + s * 0.10, w, s * 0.09), Qt.AlignCenter, "km/h")


class CarView(QWidget):
    WHEEL_X = 0.26
    WHEEL_Y_FRONT = 0.26
    WHEEL_Y_REAR = 0.755
    WHEEL_W = 0.030
    WHEEL_H = 0.110

    def __init__(self, parent=None):
        super().__init__(parent)
        self.tpms = [33, 33, 32, 32]
        self.tpms_temp = [30, 30, 29, 29]
        self.car_pixmap = load_pixmap(CAR_IMAGES)
        self._scaled = None
        self._scaled_h = -1
        self.setMinimumSize(260, 260)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_tpms(self, tpms, tpms_temp=None):
        self.tpms = tpms
        if tpms_temp:
            self.tpms_temp = tpms_temp
        self.update()

    def _scaled_car(self, height):
        if self._scaled_h != height:
            self._scaled = self.car_pixmap.scaledToHeight(height, Qt.SmoothTransformation)
            self._scaled_h = height
        return self._scaled

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        cx = w / 2
        top = 6
        ih = max(80, int(h - 34 - top))

        if self.car_pixmap:
            sp = self._scaled_car(ih)
            iw = sp.width()
            p.drawPixmap(int(cx - iw / 2), top, sp)
        else:
            iw = ih * 0.76
            p.setPen(QPen(QColor("#475569"), 2))
            p.setBrush(Qt.NoBrush)
            p.drawRoundedRect(QRectF(cx - iw * 0.2, top + ih * 0.12, iw * 0.4, ih * 0.76), 20, 20)

        tw, th = iw * self.WHEEL_W, ih * self.WHEEL_H
        yf = top + ih * self.WHEEL_Y_FRONT
        yr = top + ih * self.WHEEL_Y_REAR
        dx = iw * self.WHEEL_X
        centers = [(cx - dx, yf), (cx + dx, yf), (cx - dx, yr), (cx + dx, yr)]

        for i, (x, y) in enumerate(centers):
            psi = self.tpms[i]
            t_val = self.tpms_temp[i] if i < len(self.tpms_temp) else 30
            ok = TIRE_MIN <= psi <= TIRE_MAX
            col = QColor(GREEN if ok else RED)
            wx, wy = x - tw / 2, y - th / 2

            p.setPen(Qt.NoPen)
            p.setBrush(col)
            p.drawRoundedRect(QRectF(wx, wy, tw, th), 3, 3)

            tx = wx - 52 if i % 2 == 0 else wx + tw + 4
            ty = y - 19
            p.setPen(col)
            p.setFont(font(15, True))
            p.drawText(QRectF(tx, ty, 48, 20), Qt.AlignCenter, f"{psi} PSI")
            p.setPen(QColor("#64748b"))
            p.setFont(font(10, True))
            p.drawText(QRectF(tx, ty + 18, 48, 14), Qt.AlignCenter, f"{t_val}°C")

        p.setPen(QColor("#64748b"))
        p.setFont(font(11))
        p.drawText(QRectF(0, h - 24, w, 20), Qt.AlignCenter,
                   f"Tekanan ideal {TIRE_MIN}–{TIRE_MAX} PSI")


