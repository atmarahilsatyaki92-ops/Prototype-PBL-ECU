class Simulator:
    def __init__(self):
        self.speed = 0.0
        self.target = 0.0
        self.temp = 29.0
        self.fuel = 85.0
        self.tick = 0
        self.drive_mode = "EV"

    def step(self):
        self.tick += 1
        if self.tick % 60 == 1:
            self.target = random.choice([0.0, random.uniform(20, 85)])
        
        accel_val = (self.target - self.speed) * 0.1
        accel_val = max(-1.5, min(0.8, accel_val))
        accel_state = "ACCEL" if accel_val > 0.1 else ("DECEL" if accel_val < -0.1 else "HOLD")
        
        self.speed = max(0.0, self.speed + accel_val)
        
        mult = 1.0 if self.drive_mode == "EV" else (0.4 if self.drive_mode == "HYBRID" else 0.05)
        current = (self.speed * 0.3 + accel_val * 6 + random.uniform(-0.3, 0.3)) * mult
        current = max(-15.0, min(35.0, current))
        voltage = 77.5 - 0.05 * current + random.uniform(-0.1, 0.1)
        
        # Pengurangan Bensin saat Mode ICE / HYBRID aktif
        if self.drive_mode in ["ICE", "HYBRID"] and self.speed > 0:
            self.fuel = max(5.0, self.fuel - 0.01)

        if self.drive_mode == "ICE" and self.tick % 200 < 50:
            voltage = 63.0

        self.temp = max(27.0, min(32.0, self.temp + random.uniform(-0.05, 0.05)))
        
        return {
            "speed": round(self.speed, 1), "voltage": round(voltage, 1),
            "current": round(current, 1), "temp": round(self.temp, 1),
            "fuel_level": round(self.fuel, 1),
            "tpms": [33, 33, 32, 32], "tpms_temp": [31, 31, 30, 30],
            "door": False, "belt": True, "drive_mode": self.drive_mode,
            "accel_state": accel_state
        }


