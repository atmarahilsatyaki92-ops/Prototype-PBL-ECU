# ---------------------------------------------------------
# Custom Widget: Speedometer Semi-Gauge (Melengkung)
# ---------------------------------------------------------
class SemiGaugeWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.value = 0  # Speed (km/h)
        self.setMinimumSize(200, 160)

    def set_value(self, val):
        self.value = max(0, min(180, val))
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        width = self.width()
        height = self.height()
        rect = QRectF(20, 20, width - 40, width - 40)

        # Draw Background Arc
        pen_bg = QPen(QColor("#334155"), 16, Qt.SolidLine, Qt.RoundCap)
        painter.setPen(pen_bg)
        painter.drawArc(rect, 30 * 16, 120 * 16)

        # Draw Active Value Arc
        angle_span = int(-120 * (self.value / 120.0) * 16)
        pen_val = QPen(QColor("#38bdf8"), 16, Qt.SolidLine, Qt.RoundCap)
        painter.setPen(pen_val)
        painter.drawArc(rect, 150 * 16, angle_span)

        # Draw Text Speed
        painter.setPen(QColor("#f8fafc"))
        painter.setFont(QFont("Segoe UI", 28, QFont.Bold))
        painter.drawText(QRectF(0, height/2 - 25, width, 40), Qt.AlignCenter, f"{int(self.value)}")

        painter.setPen(QColor("#94a3b8"))
        painter.setFont(QFont("Segoe UI", 9, QFont.Bold))
        painter.drawText(QRectF(0, height/2 + 15, width, 20), Qt.AlignCenter, "KM / H")

# ---------------------------------------------------------
# Custom Widget: Vehicle Status (Gambar Mobil, TPMS, Safety & Meters)
# ---------------------------------------------------------
class CarViewWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.soc = 76
        self.temp = 28
        self.tpms = [33, 33, 32, 32]  # [FL, FR, RL, RR] in PSI
        self.door_open = False
        self.belt_fastened = True
        self.setMinimumSize(320, 240)

    def set_data(self, soc, temp, tpms, door, belt):
        self.soc = max(0, min(100, soc))
        self.temp = max(0, min(100, temp))
        self.tpms = tpms
        self.door_open = door
        self.belt_fastened = belt
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        w = self.width()
        h = self.height()
        cx = w / 2

        # 1. Tampilkan Gambar Mobil di Tengah
        img_path = "car_topview.png"
        if not os.path.exists(img_path):
            img_path = "car_topview.png.jfif"

        if os.path.exists(img_path):
            pixmap = QPixmap(img_path)
            scaled_pixmap = pixmap.scaledToHeight(int(h - 30), Qt.SmoothTransformation)
            img_x = int(cx - scaled_pixmap.width() / 2)
            img_y = int((h - scaled_pixmap.height()) / 2)
            painter.drawPixmap(img_x, img_y, scaled_pixmap)
        else:
            # Fallback Outline Mobil jika gambar tidak ditemukan
            painter.setPen(QPen(QColor("#475569"), 2))
            painter.drawRoundedRect(QRectF(cx - 35, h/2 - 65, 70, 130), 20, 20)

        # 2. Indikator TPMS (4 Ban) di Sekitar Mobil - Posisi yang sudah Disesuaikan
        wheels = [
            (cx - 43, h/2 - 50), # Front Left (FL)
            (cx + 33, h/2 - 50), # Front Right (FR)
            (cx - 43, h/2 + 50), # Rear Left (RL)
            (cx + 33, h/2 + 50)  # Rear Right (RR)
        ]

        for i, (wx, wy) in enumerate(wheels):
            psi = self.tpms[i]
            wheel_color = QColor("#10b981") if 30 <= psi <= 36 else QColor("#ef4444")
            
            # Gambar Ban (Lebih ramping agar muat di area roda mobil)
            painter.setBrush(wheel_color)
            painter.setPen(Qt.NoPen)
            painter.drawRoundedRect(QRectF(wx, wy, 10, 24), 3, 3)
            
            # Teks Tekanan (PSI) - Digeser ke luar agar tidak tumpang tindih
            painter.setPen(QColor("#94a3b8"))
            painter.setFont(QFont("Segoe UI", 7, QFont.Bold))
            text_x = wx - 26 if i % 2 == 0 else wx + 14
            painter.drawText(QRectF(text_x, wy + 4, 22, 18), Qt.AlignCenter, f"{psi}")

        # 3. Indikator Sabuk Pengaman & Pintu (Samping Mobil)
        belt_color = QColor("#10b981") if self.belt_fastened else QColor("#ef4444")
        painter.setBrush(belt_color)
        painter.setPen(Qt.NoPen)
        painter.drawEllipse(int(cx - 10), int(h/2 - 10), 8, 8)
        painter.drawEllipse(int(cx + 2), int(h/2 - 10), 8, 8)

        # 4. Vertical Meter Kiri: Baterai (%)
        bar_x_left = 22
        bar_y = 40
        bar_w = 8
        bar_h = h - 90

        painter.setBrush(QColor("#1e293b"))
        painter.drawRoundedRect(QRectF(bar_x_left, bar_y, bar_w, bar_h), 4, 4)

        fill_h_bat = (self.soc / 100.0) * bar_h
        painter.setBrush(QColor("#38bdf8"))
        painter.drawRoundedRect(QRectF(bar_x_left, bar_y + (bar_h - fill_h_bat), bar_w, fill_h_bat), 4, 4)

        painter.setPen(QColor("#94a3b8"))
        painter.setFont(QFont("Segoe UI", 9))
        painter.drawText(QRectF(bar_x_left - 15, bar_y - 25, 38, 20), Qt.AlignCenter, "🔋")
        painter.setPen(QColor("#f8fafc"))
        painter.setFont(QFont("Segoe UI", 9, QFont.Bold))
        painter.drawText(QRectF(bar_x_left - 20, bar_y + bar_h + 8, 48, 20), Qt.AlignCenter, f"{self.soc}%")

        # 5. Vertical Meter Kanan: Suhu (°C)
        bar_x_right = w - 30

        painter.setBrush(QColor("#1e293b"))
        painter.drawRoundedRect(QRectF(bar_x_right, bar_y, bar_w, bar_h), 4, 4)

        fill_h_temp = (self.temp / 60.0) * bar_h
        painter.setBrush(QColor("#38bdf8"))
        painter.drawRoundedRect(QRectF(bar_x_right, bar_y + (bar_h - fill_h_temp), bar_w, fill_h_temp), 4, 4)

        painter.setPen(QColor("#94a3b8"))
        painter.setFont(QFont("Segoe UI", 9))
        painter.drawText(QRectF(bar_x_right - 15, bar_y - 25, 38, 20), Qt.AlignCenter, "🌡️")
        painter.setPen(QColor("#f8fafc"))
        painter.setFont(QFont("Segoe UI", 9, QFont.Bold))
        painter.drawText(QRectF(bar_x_right - 20, bar_y + bar_h + 8, 48, 20), Qt.AlignCenter, f"{int(self.temp)}°C")

# ---------------------------------------------------------
# Main Application Window
# ---------------------------------------------------------
class EVDashboard(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("STM32 EV Telemetry Monitoring System")
        self.resize(1050, 800)
        self.setStyleSheet("background-color: #090d16; color: #f8fafc;")

        self.ser = None
        self.init_serial()

        self.power_history = []
        self.current_history = []

        self.init_ui()

        self.timer = QTimer()
        self.timer.setInterval(100)
        self.timer.timeout.connect(self.update_telemetry)
        self.timer.start()

    def init_serial(self):
        ports = list(list_ports.comports())
        for p in ports:
            if any(k in p.description for k in ["STM", "CH340", "CP210"]):
                try:
                    self.ser = serial.Serial(p.device, 115200, timeout=0.1)
                    break
                except Exception:
                    pass

    def init_ui(self):
        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        main_layout = QVBoxLayout(main_widget)
        main_layout.setSpacing(12)

        # 1. Header Bar
        header = QHBoxLayout()
        title = QLabel("STM32 EV Telemetry  <span style='color: #10b981;'>● LIVE (2 Hz)</span>")
        title.setFont(QFont("Segoe UI", 14, QFont.Bold))
        subtitle = QLabel("CAN Bus Stream • Microcontroller STM32F4 ECU Node")
        subtitle.setStyleSheet("color: #64748b; font-size: 11px;")
        
        v_title = QVBoxLayout()
        v_title.addWidget(title)
        v_title.addWidget(subtitle)

        header.addLayout(v_title)
        header.addStretch()
        main_layout.addLayout(header)

        # 2. Top Section: Speedometer & Vehicle Status Box
        top_grid = QHBoxLayout()

        # Box Kiri: Speed & Power
        vss_box = QFrame()
        vss_box.setStyleSheet("background-color: #111827; border: 1px solid #1f293d; border-radius: 12px; padding: 10px;")
        vss_layout = QVBoxLayout(vss_box)
        
        lbl_vss_title = QLabel("Vehicle Speed & Power")
        lbl_vss_title.setStyleSheet("color: #94a3b8; font-size: 12px; font-weight: bold;")
        
        self.gauge_widget = SemiGaugeWidget()
        
        pwr_layout = QHBoxLayout()
        lbl_pwr_desc = QLabel("Instant Power Draw")
        lbl_pwr_desc.setStyleSheet("color: #94a3b8; font-size: 11px;")
        self.lbl_pwr_val = QLabel("0.00 kW")
        self.lbl_pwr_val.setStyleSheet("color: #f8fafc; font-size: 12px; font-weight: bold;")
        pwr_layout.addWidget(lbl_pwr_desc)
        pwr_layout.addStretch()
        pwr_layout.addWidget(self.lbl_pwr_val)

        self.pwr_bar = QProgressBar()
        self.pwr_bar.setMaximum(100)
        self.pwr_bar.setTextVisible(False)
        self.pwr_bar.setFixedHeight(8)
        self.pwr_bar.setStyleSheet("""
            QProgressBar { background-color: #1e293b; border-radius: 4px; }
            QProgressBar::chunk { background-color: #38bdf8; border-radius: 4px; }
        """)

        vss_layout.addWidget(lbl_vss_title)
        vss_layout.addWidget(self.gauge_widget)
        vss_layout.addLayout(pwr_layout)
        vss_layout.addWidget(self.pwr_bar)

        # Box Kanan: Vehicle Status
        car_box = QFrame()
        car_box.setStyleSheet("background-color: #111827; border: 1px solid #1f293d; border-radius: 12px; padding: 10px;")
        car_layout = QVBoxLayout(car_box)

        lbl_car_title = QLabel("Vehicle Status (TPMS, Safety & Meters)")
        lbl_car_title.setStyleSheet("color: #94a3b8; font-size: 12px; font-weight: bold;")

        self.car_widget = CarViewWidget()

        car_layout.addWidget(lbl_car_title)
        car_layout.addWidget(self.car_widget)

        top_grid.addWidget(vss_box, stretch=1)
        top_grid.addWidget(car_box, stretch=1)
        main_layout.addLayout(top_grid)

        # 3. Middle Section: System Status (Tegangan/Arus Baterai & O2 Lambda)
        mid_grid = QHBoxLayout()

        self.card_bat_frame, self.lbl_bat_badge, self.lbl_bat_val = self.create_compact_card("Battery Pack Status", "77.5 V | 8.2 A", "#38bdf8", "CHARGING ⚡")
        self.card_o2_frame, self.lbl_o2_badge, self.lbl_o2_val = self.create_compact_card("O2 Lambda Ratio", "1.02 λ", "#a855f7", "STOICH")

        mid_grid.addWidget(self.card_bat_frame, stretch=1)
        mid_grid.addWidget(self.card_o2_frame, stretch=1)
        main_layout.addLayout(mid_grid)

        # 4. Bottom Section: Live Telemetry Graph
        pg.setConfigOption('background', '#111827')
        pg.setConfigOption('foreground', '#64748b')

        self.graph_widget = pg.PlotWidget()
        self.graph_widget.setTitle("Live Telemetry History (Power Draw & Battery Current)", color="#94a3b8", size="9pt")
        self.graph_widget.showGrid(x=True, y=True, alpha=0.2)
        
        self.curve_pwr = self.graph_widget.plot(pen=pg.mkPen(color="#38bdf8", width=2))
        self.curve_curr = self.graph_widget.plot(pen=pg.mkPen(color="#818cf8", width=2, style=Qt.DashLine))

        main_layout.addWidget(self.graph_widget, stretch=2)

    def create_compact_card(self, title, val, color, badge_txt):
        card = QFrame()
        card.setStyleSheet("background-color: #111827; border: 1px solid #1f293d; border-radius: 10px; padding: 12px;")
        layout = QVBoxLayout(card)

        top_h = QHBoxLayout()
        lbl_t = QLabel(title)
        lbl_t.setStyleSheet("color: #94a3b8; font-size: 11px; font-weight: bold;")
        lbl_b = QLabel(badge_txt)
        lbl_b.setStyleSheet(f"color: {color}; font-size: 9px; font-weight: bold; background-color: #0f172a; padding: 2px 6px; border-radius: 4px;")
        top_h.addWidget(lbl_t)
        top_h.addStretch()
        top_h.addWidget(lbl_b)

        lbl_v = QLabel(val)
        lbl_v.setStyleSheet("color: #f8fafc; font-size: 20px; font-weight: bold;")

        layout.addLayout(top_h)
        layout.addWidget(lbl_v)
        return card, lbl_b, lbl_v

    def update_telemetry(self):
        data = None
        if self.ser and self.ser.in_waiting:
            try:
                line = self.ser.readline().decode('utf-8').strip()
                data = json.loads(line)
            except Exception:
                pass

        if not data:
            speed = round(random.uniform(0.0, 75.0), 1)
            voltage = round(random.uniform(74.0, 78.0), 1)
            current = round(random.uniform(-15.0, 35.0), 1)
            power = round((voltage * abs(current)) / 1000.0, 2)
            soc = int(max(0, min(100, ((voltage - 60.0) / (84.0 - 60.0)) * 100)))
            temp = round(random.uniform(27.0, 31.0), 1)
            
            if current < -0.5:
                status_mode = "CHARGING ⚡"
                mode_color = "#38bdf8"
            elif current > 0.5 and speed > 0:
                status_mode = "DISCHARGING ⚡"
                mode_color = "#f59e0b"
            else:
                status_mode = "STANDBY"
                mode_color = "#10b981"

            data = {
                "speed": speed, "voltage": voltage, "current": current, "power": power,
                "soc": soc, "temp": temp, "mode": status_mode, "mode_color": mode_color,
                "tpms": [33, 33, 32, 32], "door": False, "belt": True,
                "o2": round(random.uniform(0.99, 1.03), 2)
            }

        # Update VSS Gauge & Power
        self.gauge_widget.set_value(data.get('speed', 0))
        pwr = data.get('power', 0.0)
        self.lbl_pwr_val.setText(f"{pwr} kW")
        self.pwr_bar.setValue(int(min(100, (pwr / 5.0) * 100)))

        # Update Car View Widget (Gambar, TPMS, Safety & Meters)
        self.car_widget.set_data(
            data.get('soc', 76),
            data.get('temp', 28),
            data.get('tpms', [33, 33, 32, 32]),
            data.get('door', False),
            data.get('belt', True)
        )

        # Update Middle Status Cards
        mode_txt = data.get('mode', 'STANDBY')
        mode_color = data.get('mode_color', '#10b981')
        self.lbl_bat_val.setText(f"{data.get('voltage', 0)} V | {abs(data.get('current', 0))} A")
        self.lbl_bat_badge.setText(mode_txt)
        self.lbl_bat_badge.setStyleSheet(f"color: {mode_color}; font-size: 9px; font-weight: bold; background-color: #0f172a; padding: 2px 6px; border-radius: 4px;")

        self.lbl_o2_val.setText(f"{data.get('o2', 1.0)} λ")

        # Update Graph History
        self.power_history.append(pwr)
        self.current_history.append(abs(data.get('current', 0)))
        if len(self.power_history) > 40:
            self.power_history.pop(0)
            self.current_history.pop(0)

        self.curve_pwr.setData(self.power_history)
        self.curve_curr.setData(self.current_history)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = EVDashboard()
    window.show()
    sys.exit(app.exec_())