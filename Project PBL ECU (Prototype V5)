    def change_drive_mode(self, mode_key):
        self.btn_ev.setChecked(mode_key == "EV")
        self.btn_hybrid.setChecked(mode_key == "HYBRID")
        self.btn_ice.setChecked(mode_key == "ICE")

        style_active = "background-color: #0284c7; color: white; border-radius: 4px; padding: 3px 8px;"
        style_inactive = "background-color: #1e293b; color: #94a3b8; border-radius: 4px; padding: 3px 8px;"

        self.btn_ev.setStyleSheet(style_active if mode_key == "EV" else style_inactive)
        self.btn_hybrid.setStyleSheet(style_active if mode_key == "HYBRID" else style_inactive)
        self.btn_ice.setStyleSheet(style_active if mode_key == "ICE" else style_inactive)

        self.on_drive_mode_change(mode_key)

    def update_mode_pill(self, mode_key):
        txt, col, desc, bg_color, border_color = DRIVE_MODES.get(mode_key, DRIVE_MODES["EV"])
        self.pill_mode.setText(f"🚗  MODE PENGGERAK: {txt}\n   ({desc})")
        self.pill_mode.setStyleSheet(f"""
            QPushButton {{
                background-color: {bg_color};
                color: {col};
                border: 1px solid {border_color};
                border-radius: 18px;
                padding: 6px 16px;
            }}
        """)

    def render(self, d):
        speed = float(d["speed"])
        volt = float(d["voltage"])
        cur = float(d["current"])
        soc = int(d["soc"])
        temp = float(d["temp"])
        fuel = float(d.get("fuel", 85.0))
        pwr = float(d["power"])
        drive_mode = d.get("drive_mode", "EV")

        self.gauge.set_value(speed)

        # Update Battery Top & SoC Cards
        self.card_bat_top.lbl_val.setText(f"{soc}%")
        self.card_bat_top.bat_bar.setValue(soc)

        self.lbl_c1_v.setText(f"{volt:.1f} V")
        self.lbl_c2_v.setText(f"{volt:.1f} V")
        self.lbl_c3_v.setText(f"{cur:.1f} A")

        self.card_bat_soc.update_data(soc, f"{soc}% SoC")
        
        fuel_liters = round((fuel / 100.0) * FUEL_CAPACITY_LITERS, 1)
        self.card_fuel_tank.update_data(int(fuel), "Tangki Bensin", f"{fuel_liters} L / {FUEL_CAPACITY_LITERS} L")

        # Update Power Draw
        self.lbl_pwr_val.setText(f"{pwr:.2f} kW")
        self.power_history.append(pwr)
        self.chart.set_values(list(self.power_history))

        # Update Center View
        self.center_car.set_data(soc, temp)

        # Update Bottom Pills
        em_key = d.get("energy_mode", "IDLE")
        if drive_mode == "ICE":
            em_txt, em_col, em_sub = MODE_ENERGY_ICE.get(em_key, MODE_ENERGY_ICE["BATTERY_HOLD"])
        else:
            em_txt, em_col, em_sub = MODE_ENERGY_EV.get(em_key, MODE_ENERGY_EV["IDLE"])

        self.pill_bat.setText(f"⚡  KONDISI BATERAI: {em_txt}")
        
        # PERBAIKAN: Pembaruan visual Pill Mode Penggerak real-time
        self.update_mode_pill(drive_mode)
        self.btn_ev.setChecked(drive_mode == "EV")
        self.btn_hybrid.setChecked(drive_mode == "HYBRID")
        self.btn_ice.setChecked(drive_mode == "ICE")


# ---------------------------------------------------------
# Window Utama Aplikasi
# ---------------------------------------------------------
class EVDashboardMain(QMainWindow):
    def __init__(self, port=None):
        super().__init__()
        self.setWindowTitle("Smart E-Vehicle Monitoring System - Polibatam")
        self.setStyleSheet(
            "QMainWindow { background-color: #070b14; }"
            "QLabel { background: transparent; color: #f8fafc; }"
        )
        screen = QApplication.primaryScreen().availableGeometry()
        self.resize(min(1280, screen.width() - 40), min(820, screen.height() - 60))

        self.ser = None
        self.port_name = None
        self.init_serial(port)
        self.demo = self.ser is None

        self.raw = dict(DEFAULT_RAW)
        self.sim = Simulator()

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.page_auth = AuthPage(self.on_login_success)
        self.page_dash = DashboardPage(self.on_logout, self.on_drive_mode_change)

        self.stack.addWidget(self.page_auth)
        self.stack.addWidget(self.page_dash)

        self.stack.setCurrentWidget(self.page_auth)

        self.timer = QTimer()
        self.timer.setInterval(UPDATE_MS)
        self.timer.timeout.connect(self.update_telemetry)
        self.timer.start()

        self.clock_timer = QTimer()
        self.clock_timer.setInterval(1000)
        self.clock_timer.timeout.connect(self.update_clock)
        self.clock_timer.start()

    def init_serial(self, port=None):
        if serial is None:
            return
        if port is None:
            for p in list_ports.comports():
                text = f"{p.description} {p.manufacturer or ''}"
                if any(k in text for k in ["STM", "CH340", "CP210"]):
                    port = p.device
                    break
        if port is None:
            return
        try:
            self.ser = serial.Serial(port, BAUDRATE, timeout=0.05)
            self.port_name = port
        except Exception:
            pass

    def read_serial(self):
        packet = None
        try:
            while self.ser and self.ser.in_waiting:
                line = self.ser.readline().decode("utf-8", errors="ignore").strip()
                if line:
                    obj = json.loads(line)
                    if isinstance(obj, dict):
                        packet = obj
        except Exception:
            self.ser = None
        return packet

    def on_login_success(self, user_info):
        self.page_dash.lbl_user.setText(user_info)
        self.stack.setCurrentWidget(self.page_dash)

    def on_logout(self):
        self.stack.setCurrentWidget(self.page_auth)

    def on_drive_mode_change(self, mode_key):
        self.raw["drive_mode"] = mode_key
        self.sim.drive_mode = mode_key

    def update_clock(self):
        now = datetime.datetime.now()
        time_str = now.strftime("%H:%M")
        self.page_dash.lbl_time.setText(time_str)

    def update_telemetry(self):
        if self.demo:
            self.raw.update(self.sim.step())
        elif self.ser:
            packet = self.read_serial()
            if packet:
                self.raw.update(packet)

        if self.stack.currentWidget() == self.page_dash:
            self.page_dash.render(build_view(self.raw))


if __name__ == "__main__":
    port_arg = sys.argv[1] if len(sys.argv) > 1 else None
    QApplication.setAttribute(Qt.AA_EnableHighDpiScaling, True)
    app = QApplication(sys.argv)
    window = EVDashboardMain(port_arg)
    window.show()
    sys.exit(app.exec_())