class Simulator:
    def __init__(self):
        self.speed = 61.0
        self.target = 61.0
        self.temp = 28.0
        self.fuel = 77.0
        self.tick = 0
        self.drive_mode = "ICE"
        self.gear = "D"
        self.idle_counter = 0

    def step(self):
        self.tick += 1
        if self.tick % 60 == 1:
            self.target = random.choice([0.0, 30.0, 61.0, 85.0, 0.0])
        
        accel_val = (self.target - self.speed) * 0.05
        accel_val = max(-1.5, min(0.8, accel_val))
        accel_state = "ACCEL" if accel_val > 0.1 else ("DECEL" if accel_val < -0.1 else "HOLD")
        
        self.speed = max(0.0, self.speed + accel_val)
        
        if self.speed > 1.0:
            self.gear = "D"
            self.idle_counter = 0
        elif self.speed <= 1.0:
            self.idle_counter += 1
            if self.idle_counter < 15:
                self.gear = "N"
            else:
                self.gear = "P"

        mult = 1.0 if self.drive_mode == "EV" else (0.4 if self.drive_mode == "HYBRID" else 0.05)
        current = (self.speed * 0.08 + random.uniform(-0.1, 0.1)) * mult
        current = max(0.0, min(120.0, current))
        voltage = 76.6 - 0.01 * current + random.uniform(-0.02, 0.02)
        
        if self.drive_mode in ["ICE", "HYBRID"] and self.speed > 0:
            self.fuel = max(5.0, self.fuel - 0.005)

        return {
            "speed": round(self.speed, 1), "voltage": round(voltage, 1),
            "current": round(current, 1), "temp": round(self.temp, 1),
            "bat_temp": 32.0, "soh": 94, "est_range": 120,
            "fuel_level": round(self.fuel, 1),
            "tpms": [33, 33, 37, 37], "tpms_temp": [28, 28, 28, 28],
            "door": False, "belt": True, "drive_mode": self.drive_mode,
            "accel_state": accel_state, "gear": self.gear
        }


