class SpeedGauge(QWidget):
    START = 225.0
    SPAN = 270.0

    def __init__(self, parent=None):
        super().__init__(parent)
        self.value = 51.0
        self.setMinimumSize(220, 220)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, v):
        self.value = max(0.0, min(float(MAX_SPEED), v))
        self.update()

    def _pt(self, cx, cy, rad, v):
        a = math.radians(self.START - self.SPAN * v / MAX_SPEED)
        return QPointF(cx + rad * math.cos(a), cy - rad * math.sin(a))

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        s = min(w, h)
        cx, cy = w / 2, h / 2
        pw = s * 0.045
        r = s / 2 - pw / 2 - 4
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1e293b"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, int(self.START * 16), int(-self.SPAN * 16))
        
        for lo, hi, col in ((ZONE_WARN, ZONE_RED, "#f59e0b"), (ZONE_RED, MAX_SPEED, "#ef4444")):
            a0 = self.START - self.SPAN * lo / MAX_SPEED
            span = -self.SPAN * (hi - lo) / MAX_SPEED
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.FlatCap))
            p.drawArc(rect, int(a0 * 16), int(span * 16))

        if self.value > 0.5:
            col = RED if self.value >= ZONE_RED else (AMBER if self.value >= ZONE_WARN else CYAN)
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, int(self.START * 16), int(-self.SPAN * (self.value / MAX_SPEED) * 16))

        r_in = r - pw / 2 - s * 0.025
        for v in range(0, MAX_SPEED + 1, 10):
            major = v % 30 == 0
            ln = s * (0.045 if major else 0.025)
            p.setPen(QPen(QColor("#cbd5e1" if major else "#334155"), 2.0 if major else 1.0))
            p.drawLine(self._pt(cx, cy, r_in, v), self._pt(cx, cy, r_in - ln, v))
            if major:
                lp = self._pt(cx, cy, r_in - s * 0.09, v)
                p.setFont(font(s * 0.040, True))
                p.setPen(QColor("#cbd5e1"))
                p.drawText(QRectF(lp.x() - 20, lp.y() - 10, 40, 20), Qt.AlignCenter, str(v))

        p.setPen(QColor("#94a3b8"))
        p.setFont(font(s * 0.038, True))
        p.drawText(QRectF(0, cy - s * 0.25, w, s * 0.06), Qt.AlignCenter, "KECEPATAN")
        p.setPen(QColor("#ffffff"))
        p.setFont(font(s * 0.28, True))
        p.drawText(QRectF(0, cy - s * 0.18, w, s * 0.30), Qt.AlignCenter, str(int(self.value)))
        p.setPen(QColor(GRAY))
        p.setFont(font(s * 0.06, True))
        p.drawText(QRectF(0, cy + s * 0.14, w, s * 0.08), Qt.AlignCenter, "km/h")


class FilledAreaChart(QWidget):
    def __init__(self, color=CYAN, parent=None):
        super().__init__(parent)
        self.values = [0.2, 0.4, 0.5, 0.4, 0.6, 0.8, 0.7, 0.9, 1.2, 1.1, 1.4, 1.52]
        self.color = QColor(color)
        self.setFixedHeight(110)

    def set_values(self, vals):
        if vals:
            self.values = vals
            self.update()

    def paintEvent(self, event):
        if len(self.values) < 2:
            return
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = self.width(), self.height()
        hi = max(max(self.values), 2.0)
        
        pts = [QPointF(i * w / (len(self.values) - 1), h - (v / hi) * (h - 10))
               for i, v in enumerate(self.values)]

        path = QPainterPath()
        path.moveTo(0, h)
        for pt in pts:
            path.lineTo(pt)
        path.lineTo(w, h)
        path.closeSubpath()

        grad = QLinearGradient(0, 0, 0, h)
        grad.setColorAt(0, QColor(56, 189, 248, 180))
        grad.setColorAt(1, QColor(56, 189, 248, 10))

        p.fillPath(path, grad)
        
        line = QPainterPath(pts[0])
        for pt in pts[1:]:
            line.lineTo(pt)
        p.setPen(QPen(QColor(CYAN), 2.5))
        p.drawPath(line)


class CarCenterView(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.soc = 76
        self.temp = 28
        self.car_pixmap = load_pixmap(CAR_IMAGES)
        self._scaled = None
        self._scaled_h = -1
        self.setMinimumSize(220, 260)

    def set_data(self, soc, temp):
        self.soc = soc
        self.temp = temp
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)

        w, h = self.width(), self.height()
        cx = w / 2
        top = 10
        ih = max(100, int(h - 20))

        if self.car_pixmap:
            if self._scaled_h != ih:
                self._scaled = self.car_pixmap.scaledToHeight(ih, Qt.SmoothTransformation)
                self._scaled_h = ih
            iw = self._scaled.width()
            p.drawPixmap(int(cx - iw / 2), top, self._scaled)
        else:
            iw = ih * 0.7
            p.setPen(QPen(QColor("#334155"), 2))
            p.drawRoundedRect(QRectF(cx - iw * 0.25, top + ih * 0.1, iw * 0.5, ih * 0.75), 20, 20)

        # Bar Kiri - Battery Level
        bx_left = cx - iw/2 - 30
        if bx_left > 10:
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#1e293b"))
            p.drawRoundedRect(QRectF(bx_left, top + 40, 6, ih - 80), 3, 3)
            fill_h = ((ih - 80) * self.soc) / 100.0
            p.setBrush(QColor(CYAN))
            p.drawRoundedRect(QRectF(bx_left, top + 40 + (ih - 80 - fill_h), 6, fill_h), 3, 3)

            p.setPen(QColor("#ffffff"))
            p.setFont(font(10, True))
            p.drawText(QRectF(bx_left - 20, top + 15, 46, 20), Qt.AlignCenter, "🔋")
            p.drawText(QRectF(bx_left - 20, top + 32, 46, 20), Qt.AlignCenter, f"{self.soc}%")
            p.drawText(QRectF(bx_left - 20, top + ih - 35, 46, 20), Qt.AlignCenter, f"{self.soc}%")

        # Bar Kanan - Temperature
        bx_right = cx + iw/2 + 24
        if bx_right < w - 20:
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#1e293b"))
            p.drawRoundedRect(QRectF(bx_right, top + 40, 6, ih - 80), 3, 3)
            fill_h_t = ((ih - 80) * self.temp) / 60.0
            p.setBrush(QColor(CYAN))
            p.drawRoundedRect(QRectF(bx_right, top + 40 + (ih - 80 - fill_h_t), 6, fill_h_t), 3, 3)

            p.setPen(QColor("#ffffff"))
            p.setFont(font(10, True))
            p.drawText(QRectF(bx_right - 20, top + 15, 46, 20), Qt.AlignCenter, "🌡️")
            p.drawText(QRectF(bx_right - 20, top + 32, 46, 20), Qt.AlignCenter, f"{int(self.temp)}°C")
            p.drawText(QRectF(bx_right - 20, top + ih - 35, 46, 20), Qt.AlignCenter, f"{int(self.temp)}°C")


