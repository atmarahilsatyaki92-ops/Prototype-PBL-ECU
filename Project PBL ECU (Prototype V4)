class SpeedGauge(QWidget):
    START = 225.0
    SPAN = 270.0

    def __init__(self, parent=None):
        super().__init__(parent)
        self.value = 0.0
        self.setMinimumSize(250, 250)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, v):
        self.value = max(0.0, min(float(MAX_SPEED), v))
        self.update()

    def _pt(self, cx, cy, rad, v):
        a = math.radians(self.START - self.SPAN * v / MAX_SPEED)
        return QPointF(cx + rad * math.cos(a), cy - rad * math.sin(a))

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        s = min(w, h)
        cx, cy = w / 2, h / 2
        pw = s * 0.045
        r = s / 2 - pw / 2 - 4
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1e293b"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, int(self.START * 16), int(-self.SPAN * 16))
        for lo, hi, col in ((ZONE_WARN, ZONE_RED, "#4b3a12"), (ZONE_RED, MAX_SPEED, "#4b1d24")):
            a0 = self.START - self.SPAN * lo / MAX_SPEED
            span = -self.SPAN * (hi - lo) / MAX_SPEED
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.FlatCap))
            p.drawArc(rect, int(a0 * 16), int(span * 16))

        if self.value > 0.5:
            col = RED if self.value >= ZONE_RED else (AMBER if self.value >= ZONE_WARN else CYAN)
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, int(self.START * 16), int(-self.SPAN * (self.value / MAX_SPEED) * 16))

        r_in = r - pw / 2 - s * 0.025
        for v in range(0, MAX_SPEED + 1, 10):
            major = v % 30 == 0
            ln = s * (0.045 if major else 0.025)
            p.setPen(QPen(QColor("#94a3b8" if major else "#334155"), 2.0 if major else 1.0))
            p.drawLine(self._pt(cx, cy, r_in, v), self._pt(cx, cy, r_in - ln, v))
            if major:
                lp = self._pt(cx, cy, r_in - s * 0.09, v)
                p.setFont(font(s * 0.040, True))
                p.setPen(QColor("#cbd5e1"))
                p.drawText(QRectF(lp.x() - 20, lp.y() - 10, 40, 20), Qt.AlignCenter, str(v))

        p.setPen(QColor("#64748b"))
        p.setFont(font(s * 0.035, True))
        p.drawText(QRectF(0, cy - s * 0.26, w, s * 0.06), Qt.AlignCenter, "KECEPATAN")
        p.setPen(QColor("#f8fafc"))
        p.setFont(font(s * 0.24, True))
        p.drawText(QRectF(0, cy - s * 0.20, w, s * 0.28), Qt.AlignCenter, str(int(self.value)))
        p.setPen(QColor(GRAY))
        p.setFont(font(s * 0.055, True))
        p.drawText(QRectF(0, cy + s * 0.10, w, s * 0.08), Qt.AlignCenter, "km/h")


class CarView(QWidget):
    WHEEL_X = 0.26
    WHEEL_Y_FRONT = 0.26
    WHEEL_Y_REAR = 0.755
    WHEEL_W = 0.030
    WHEEL_H = 0.110

    def __init__(self, parent=None):
        super().__init__(parent)
        self.tpms = [33, 33, 32, 32]
        self.tpms_temp = [30, 30, 29, 29]
        self.soc = 85
        self.temp = 28
        self.car_pixmap = load_pixmap(CAR_IMAGES)
        self._scaled = None
        self._scaled_h = -1
        self.setMinimumSize(220, 260)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_data(self, tpms, tpms_temp, soc, temp):
        self.tpms = tpms
        if tpms_temp:
            self.tpms_temp = tpms_temp
        self.soc = max(0, min(100, soc))
        self.temp = max(0, min(100, temp))
        self.update()

    def _scaled_car(self, height):
        if self._scaled_h != height:
            self._scaled = self.car_pixmap.scaledToHeight(height, Qt.SmoothTransformation)
            self._scaled_h = height
        return self._scaled

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        cx = w / 2
        top = 10
        ih = max(80, int(h - 30 - top))

        # 1. Gambar Mobil di Tengah
        if self.car_pixmap:
            sp = self._scaled_car(ih)
            iw = sp.width()
            p.drawPixmap(int(cx - iw / 2), top, sp)
        else:
            iw = ih * 0.76
            p.setPen(QPen(QColor("#334155"), 2))
            p.setBrush(Qt.NoBrush)
            p.drawRoundedRect(QRectF(cx - iw * 0.2, top + ih * 0.12, iw * 0.4, ih * 0.76), 20, 20)

        # 2. Vertical Meters Kiri (Baterai) & Kanan (Suhu) ala Foto 2
        bar_w = 6
        bar_h = ih * 0.6
        bar_y = top + (ih - bar_h) / 2

        # Meter Baterai Kiri
        bar_x_left = cx - iw/2 - 25
        if bar_x_left > 15:
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#1e293b"))
            p.drawRoundedRect(QRectF(bar_x_left, bar_y, bar_w, bar_h), 3, 3)
            fill_h_bat = (self.soc / 100.0) * bar_h
            p.setBrush(QColor(CYAN))
            p.drawRoundedRect(QRectF(bar_x_left, bar_y + (bar_h - fill_h_bat), bar_w, fill_h_bat), 3, 3)
            p.setPen(QColor("#f8fafc"))
            p.setFont(font(9, True))
            p.drawText(QRectF(bar_x_left - 15, bar_y + bar_h + 5, 36, 15), Qt.AlignCenter, f"{self.soc}%")

        # Meter Suhu Kanan
        bar_x_right = cx + iw/2 + 18
        if bar_x_right < w - 20:
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#1e293b"))
            p.drawRoundedRect(QRectF(bar_x_right, bar_y, bar_w, bar_h), 3, 3)
            fill_h_temp = (self.temp / 60.0) * bar_h
            p.setBrush(QColor(CYAN))
            p.drawRoundedRect(QRectF(bar_x_right, bar_y + (bar_h - fill_h_temp), bar_w, fill_h_temp), 3, 3)
            p.setPen(QColor("#f8fafc"))
            p.setFont(font(9, True))
            p.drawText(QRectF(bar_x_right - 15, bar_y + bar_h + 5, 36, 15), Qt.AlignCenter, f"{int(self.temp)}°C")

        # 3. TPMS Indicators 4 Ban
        tw, th = iw * self.WHEEL_W, ih * self.WHEEL_H
        yf = top + ih * self.WHEEL_Y_FRONT
        yr = top + ih * self.WHEEL_Y_REAR
        dx = iw * self.WHEEL_X
        centers = [(cx - dx, yf), (cx + dx, yf), (cx - dx, yr), (cx + dx, yr)]

        for i, (x, y) in enumerate(centers):
            psi = self.tpms[i]
            ok = TIRE_MIN <= psi <= TIRE_MAX
            col = QColor(GREEN if ok else RED)
            wx, wy = x - tw / 2, y - th / 2

            p.setPen(Qt.NoPen)
            p.setBrush(col)
            p.drawRoundedRect(QRectF(wx, wy, tw, th), 3, 3)

            tx = wx - 42 if i % 2 == 0 else wx + tw + 2
            ty = y - 12
            p.setPen(col)
            p.setFont(font(11, True))
            p.drawText(QRectF(tx, ty, 40, 16), Qt.AlignCenter, f"{psi}")


class IconWidget(QWidget):
    def __init__(self, kind, parent=None):
        super().__init__(parent)
        self.kind = kind
        self.color = QColor(GRAY)
        self.level = 100
        self.setFixedSize(40, 40)

    def set_state(self, color, level=None):
        self.color = QColor(color)
        if level is not None:
            self.level = max(0, min(100, level))
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.translate(2, 2)
        c = self.color
        if self.kind == "battery":
            p.setPen(QPen(c, 2))
            p.setBrush(Qt.NoBrush)
            p.drawRoundedRect(QRectF(2, 8, 28, 18), 3, 3)
            p.setPen(Qt.NoPen)
            p.setBrush(c)
            p.drawRoundedRect(QRectF(30, 14, 3, 6), 1, 1)
            p.drawRoundedRect(QRectF(5, 11, 22 * self.level / 100.0, 12), 2, 2)
        elif self.kind == "fuel":
            p.setPen(QPen(c, 2))
            p.setBrush(Qt.NoBrush)
            p.drawRoundedRect(QRectF(5, 8, 20, 22), 3, 3)
            p.drawRoundedRect(QRectF(8, 11, 14, 8), 2, 2)
            p.drawLine(int(25), int(14), int(30), int(14))
            p.drawLine(int(30), int(14), int(30), int(26))
            p.setBrush(c)
            p.drawEllipse(QPointF(30, 27), 2, 2)
        elif self.kind == "voltage":
            p.setPen(QPen(c, 2))
            p.drawEllipse(QPointF(18, 18), 13, 13)
            p.setPen(Qt.NoPen)
            p.setBrush(c)
            p.drawPolygon(QPolygonF([QPointF(12, 9), QPointF(18, 22), QPointF(24, 9)]))
        elif self.kind == "current":
            p.setPen(QPen(c, 2))
