    def change_drive_mode(self, mode_key):
        self.btn_ev.setChecked(mode_key == "EV")
        self.btn_hybrid.setChecked(mode_key == "HYBRID")
        self.btn_ice.setChecked(mode_key == "ICE")

        style_active = "background-color: #0284c7; color: white; border-radius: 6px; padding: 4px 10px;"
        style_inactive = "background-color: #1e293b; color: #94a3b8; border-radius: 6px; padding: 4px 10px;"

        self.btn_ev.setStyleSheet(style_active if mode_key == "EV" else style_inactive)
        self.btn_hybrid.setStyleSheet(style_active if mode_key == "HYBRID" else style_inactive)
        self.btn_ice.setStyleSheet(style_active if mode_key == "ICE" else style_inactive)

        self.on_drive_mode_change(mode_key)

    def render(self, d):
        speed = float(d["speed"])
        volt = float(d["voltage"])
        cur = float(d["current"])
        soc = int(d["soc"])
        temp = float(d["temp"])
        fuel = float(d.get("fuel", 85.0))
        pwr = float(d["power"])
        drive_mode = d.get("drive_mode", "EV")

        self.gauge.set_value(speed)

        # 1. Update Cards Telemetri Kiri
        bc, bt = (GREEN, "Baik") if soc >= 50 else ((AMBER, "Sedang") if soc >= 20 else (RED, "Rendah"))
        self.card_bat.update_card(f"{soc}", "%", "Nominal 72V", bt, bc, soc)

        fuel_liters = round((fuel / 100.0) * FUEL_CAPACITY_LITERS, 1)
        fc, ft = (GREEN, "Penuh") if fuel >= 50 else ((AMBER, "Cukup") if fuel >= 20 else (RED, "Rendah"))
        self.card_fuel.update_card(f"{int(fuel)}", "%", f"{fuel_liters} L / {FUEL_CAPACITY_LITERS}L", ft, fc, int(fuel))

        vc = GREEN if 70.0 <= volt <= 82.0 else RED
        self.card_volt.update_card(f"{volt:.1f}", "V", "Baterai Utama", "Normal" if vc == GREEN else "Anomali", vc)

        cc = CYAN if cur < 0 else (AMBER if cur > 20 else GREEN)
        cur_status = "Charging" if cur < 0 else ("Beban Tinggi" if cur > 20 else "Normal")
        self.card_curr.update_card(f"{abs(cur):.1f}", "A", "Arus Masuk/Keluar", cur_status, cc)

        # 2. Update Power Draw
        self.lbl_pwr_val.setText(f"{pwr:.2f} kW")
        self.power_history.append(pwr)
        self.spark.set_values(list(self.power_history))

        # 3. Update Visual Mobil & TPMS
        tpms = d.get("tpms", [33, 33, 32, 32])
        tpms_temp = d.get("tpms_temp", [30, 30, 29, 29])
        self.car_view.set_data(tpms, tpms_temp, soc, temp)

        # 4. Update Tiles Bawah
        bad = [(TIRE_NAMES[i], v) for i, v in enumerate(tpms) if not TIRE_MIN <= v <= TIRE_MAX]
        if bad:
            self.tile_tire.update_tile("Periksa Ban", ", ".join(f"{n} {v} PSI" for n, v in bad), RED, True)
        else:
            self.tile_tire.update_tile("Semua Ban Normal", f"Tekanan {TIRE_MIN}–{TIRE_MAX} PSI", GREEN)

        em_key = d.get("energy_mode", "IDLE")
        if drive_mode == "ICE":
            em_txt, em_col, em_sub = MODE_ENERGY_ICE.get(em_key, MODE_ENERGY_ICE["BATTERY_HOLD"])
        else:
            em_txt, em_col, em_sub = MODE_ENERGY_EV.get(em_key, MODE_ENERGY_EV["IDLE"])

        self.tile_energy.update_tile(em_txt, em_sub, em_col)

        if bool(d["door"]) or not bool(d["belt"]):
            self.tile_belt.update_tile("Peringatan Keamanan", "Cek pintu / sabuk pengaman", RED, True)
        else:
            self.tile_belt.update_tile("Sistem Keamanan Aman", "Pintu tertutup & sabuk terpasang", GREEN)

        dm_txt, dm_col, dm_sub = DRIVE_MODES.get(drive_mode, DRIVE_MODES["EV"])
        self.tile_mode.update_tile(dm_txt, dm_sub, dm_col)
        self.change_drive_mode(drive_mode)


