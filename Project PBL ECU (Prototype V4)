            p.setBrush(c)
            p.drawPolygon(QPolygonF([QPointF(18, 7), QPointF(11, 23), QPointF(25, 23)]))
        elif self.kind == "bolt":
            p.setPen(Qt.NoPen)
            p.setBrush(c)
            p.drawPolygon(QPolygonF([
                QPointF(20, 2), QPointF(8, 20), QPointF(16, 20),
                QPointF(14, 34), QPointF(28, 14), QPointF(19, 14)]))


class Sparkline(QWidget):
    def __init__(self, color=CYAN, parent=None):
        super().__init__(parent)
        self.values = []
        self.color = QColor(color)
        self.setFixedHeight(35)

    def set_values(self, vals):
        self.values = vals
        self.update()

    def paintEvent(self, event):
        if len(self.values) < 2:
            return
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = self.width(), self.height() - 4
        hi = max(max(self.values), 1.0)
        pts = [QPointF(i * w / (HISTORY_LEN - 1), 2 + h - (v / hi) * h)
               for i, v in enumerate(self.values)]

        line = QPainterPath(pts[0])
        for pt in pts[1:]:
            line.lineTo(pt)

        p.setPen(QPen(self.color, 2))
        p.drawPath(line)


