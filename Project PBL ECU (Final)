def load_pixmap(names):
    if isinstance(names, str):
        names = [names]
    for name in names:
        path = os.path.join(BASE_DIR, name)
        if os.path.exists(path):
            pm = QPixmap(path)
            if not pm.isNull():
                return pm
    return None


def prepare_car(pm):
    """
    Hapus latar foto mobil secara otomatis (flood-fill dari tepi) lalu crop
    tepat ke batas mobil. Kalau PNG sudah transparan, hanya di-crop.
    Return (pixmap, bersih?) -> bersih=False berarti gagal & pakai gambar asli.
    """
    img = pm.toImage().convertToFormat(QImage.Format_ARGB32)
    W, H = img.width(), img.height()
    scale = 480.0 / max(W, H)
    if scale < 1.0:
        small = img.scaled(max(1, int(W * scale)), max(1, int(H * scale)),
                           Qt.IgnoreAspectRatio, Qt.SmoothTransformation)
    else:
        small = img
    sw, sh = small.width(), small.height()
    px = [small.pixel(x, y) for y in range(sh) for x in range(sw)]

    has_alpha = any(qAlpha(c) < 250 for c in px)
    if has_alpha:
        mask = [1 if qAlpha(c) > 16 else 0 for c in px]
        if sum(mask) < sw * sh * 0.02:
            return pm, False
    else:
        border = ([px[x] for x in range(sw)] + [px[(sh - 1) * sw + x] for x in range(sw)]
                  + [px[y * sw] for y in range(sh)] + [px[y * sw + sw - 1] for y in range(sh)])
        rs = sorted(qRed(c) for c in border)
        gs = sorted(qGreen(c) for c in border)
        bs = sorted(qBlue(c) for c in border)
        mid = len(border) // 2
        br, bg_, bb = rs[mid], gs[mid], bs[mid]
        tol2 = 38 * 38

        def is_bg(c):
            dr, dg, db = qRed(c) - br, qGreen(c) - bg_, qBlue(c) - bb
            return dr * dr + dg * dg + db * db <= tol2

        seen = bytearray(sw * sh)
        dq = deque()

        def seed(x, y):
            i = y * sw + x
            if not seen[i] and is_bg(px[i]):
                seen[i] = 1
                dq.append(i)

        for x in range(sw):
            seed(x, 0)
            seed(x, sh - 1)
        for y in range(sh):
            seed(0, y)
            seed(sw - 1, y)

        while dq:
            i = dq.popleft()
            x, y = i % sw, i // sw
            if x > 0:
                seed(x - 1, y)
            if x < sw - 1:
                seed(x + 1, y)
            if y > 0:
                seed(x, y - 1)
            if y < sh - 1:
                seed(x, y + 1)

        mask = [0 if seen[i] else 1 for i in range(sw * sh)]
        ratio = sum(mask) / float(sw * sh)
        if ratio < 0.03 or ratio > 0.9:
            return pm, False

    x0s, y0s, x1s, y1s = sw, sh, -1, -1
    for y in range(sh):
        row = mask[y * sw:(y + 1) * sw]
        if 1 in row:
            y0s = min(y0s, y)
            y1s = max(y1s, y)
            x0s = min(x0s, row.index(1))
            x1s = max(x1s, sw - 1 - row[::-1].index(1))
    if x1s < 0:
        return pm, False

    mimg = QImage(sw, sh, QImage.Format_ARGB32)
    for y in range(sh):
        base = y * sw
        for x in range(sw):
            mimg.setPixel(x, y, 0xFF000000 if mask[base + x] else 0x00000000)
    mup = mimg.scaled(W, H, Qt.IgnoreAspectRatio, Qt.SmoothTransformation)

    out = QImage(W, H, QImage.Format_ARGB32_Premultiplied)
    out.fill(Qt.transparent)
    q = QPainter(out)
    q.drawImage(0, 0, img)
    q.setCompositionMode(QPainter.CompositionMode_DestinationIn)
    q.drawImage(0, 0, mup)
    q.end()

    sx, sy = W / float(sw), H / float(sh)
    padx, pady = 0.02 * sw, 0.02 * sh
    cx0 = max(0, int((x0s - padx) * sx))
    cy0 = max(0, int((y0s - pady) * sy))
    cx1 = min(W, int((x1s + 1 + padx) * sx))
    cy1 = min(H, int((y1s + 1 + pady) * sy))
    cropped = out.copy(QRect(cx0, cy0, cx1 - cx0, cy1 - cy0))
    return QPixmap.fromImage(cropped), True


def load_car():
    pm = load_pixmap(CAR_IMAGES)
    if pm is None:
        return None, False
    try:
        return prepare_car(pm)
    except Exception:
        return pm, False


def make_logo(name, size, white_bg, fallback_text):
    size = S(size)
    dpr = 2
    pm = QPixmap(size * dpr, size * dpr)
    pm.setDevicePixelRatio(dpr)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    p.setRenderHint(QPainter.SmoothPixmapTransform)

    logo = load_pixmap(name)
    if white_bg:
        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#ffffff"))
        p.drawRoundedRect(QRectF(0, 0, size, size), 8, 8)
    inner = size - 8 if white_bg else size
    if logo:
        sc = logo.scaled(int(inner * dpr), int(inner * dpr), Qt.KeepAspectRatio, Qt.SmoothTransformation)
        sc.setDevicePixelRatio(dpr)
        x = (size - sc.width() / dpr) / 2
        y = (size - sc.height() / dpr) / 2
        p.drawPixmap(QPointF(x, y), sc)
    else:
        p.setPen(QColor("#334155"))
        p.setFont(rfont(10, True))
        p.drawText(QRectF(0, 0, size, size), Qt.AlignCenter, fallback_text)
    p.end()

    lbl = QLabel()
    lbl.setPixmap(pm)
    lbl.setFixedSize(size, size)
    return lbl


def derive_energy_mode(current, speed, drive_mode, soc, accel_state="HOLD"):
    if drive_mode == "ICE":
        if soc < 20:
            return "SELF_CHARGING"
        elif accel_state == "DECEL":
            return "REGENERATIVE_READY"
        else:
            return "BATTERY_HOLD"
    else:
        if current < -0.5:
            return "CHARGING"
        if current > 0.5 or speed > 0:
            return "DISCHARGING"
        return "IDLE"


def build_view(raw):
    d = dict(raw)
    v = float(d.get("voltage", 76.6))
    i = float(d.get("current", 0.2))
    spd = float(d.get("speed", 61.0))
    dm = d.get("drive_mode", "ICE")
    accel = d.get("accel_state", "HOLD")
    fuel = float(d.get("fuel_level", 77.0))

    # SOC: pakai nilai dari firmware/simulator bila ada ("soc"),
    # kalau tidak ada diperkirakan kasar dari tegangan.
    if "soc" in d:
        soc = int(max(0, min(100, round(float(d["soc"])))))
    else:
        soc = int(max(0, min(100, (v - 60.0) / (84.0 - 60.0) * 100)))

    # Estimasi jarak: pakai "est_range" dari firmware bila ada,
    # kalau tidak dihitung dari sisa baterai dan/atau bensin sesuai mode.
    range_ev = soc / 100.0 * EV_RANGE_FULL_KM
    full_ice = FUEL_CAPACITY_LITERS * FUEL_KM_PER_L
    range_ice = fuel / 100.0 * full_ice
    if dm == "EV":
        calc_range, range_max, src = range_ev, EV_RANGE_FULL_KM, "dari baterai"
    elif dm == "HYBRID":
        calc_range, range_max, src = range_ev + range_ice, EV_RANGE_FULL_KM + full_ice, "baterai + bensin"
    else:
        calc_range, range_max, src = range_ice, full_ice, "dari bensin"
    if "est_range" in d:
        d["est_range"] = int(round(float(d["est_range"])))
    else:
        d["est_range"] = int(round(calc_range))
    d["range_max"] = range_max
    d["range_src"] = src

    d.setdefault("power", round(v * abs(i) / 1000.0, 2))
    d["soc"] = soc
    d["fuel"] = fuel
    d["energy_mode"] = derive_energy_mode(i, spd, dm, soc, accel)
    return d


