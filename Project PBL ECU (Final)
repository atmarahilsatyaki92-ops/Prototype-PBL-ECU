class AuthTile(QPushButton):
    """Tile login: ikon + judul + keterangan di atas, petunjuk singkat di bawah."""

    def __init__(self, icon, title, subtitle, hint, parent=None):
        super().__init__(parent)
        self.icon_name = icon
        self.title = title
        self.subtitle = subtitle
        self.hint = hint
        self.setCursor(Qt.PointingHandCursor)
        self.setFocusPolicy(Qt.NoFocus)
        self.setAttribute(Qt.WA_Hover, True)
        self.setMinimumHeight(S(290))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)
        w, h = float(self.width()), float(self.height())
        hover = self.underMouse()
        p.setPen(QPen(QColor("#0284c7" if hover else "#22304f"), 2))
        p.setBrush(QColor("#0c4a6e" if hover else "#152238"))
        p.drawRoundedRect(QRectF(1, 1, w - 2, h - 2), S(14), S(14))

        # kelompok atas (posisi sama dengan kotak input manual supaya sejajar)
        ic = S(56)
        top = S(34)
        draw_icon(p, self.icon_name, QRectF(w / 2 - ic / 2, top, ic, ic), "#38bdf8", 1.7)
        p.setPen(QColor("#ffffff"))
        p.setFont(font(15, True))
        p.drawText(QRectF(0, top + ic + S(12), w, S(24)), Qt.AlignCenter, self.title)
        p.setPen(QColor(GRAY))
        p.setFont(font(12))
        p.drawText(QRectF(0, top + ic + S(38), w, S(20)), Qt.AlignCenter, self.subtitle)

        # petunjuk di bawah
        hf = font(12)
        cw = text_width(hf, self.hint) + S(36)
        ch = S(34)
        chip = QRectF(w / 2 - cw / 2, h - S(26) - ch, cw, ch)
        p.setPen(QPen(QColor("#2a3b5c"), 1))
        p.setBrush(QColor("#0f1a2e"))
        p.drawRoundedRect(chip, ch / 2, ch / 2)
        p.setPen(QColor(SUBTLE))
        p.setFont(hf)
        p.drawText(chip, Qt.AlignCenter, self.hint)


