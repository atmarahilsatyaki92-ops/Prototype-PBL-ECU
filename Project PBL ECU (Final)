class CarCenterViewDetailed(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.tpms = [33, 33, 37, 37]
        self.soc = 69
        self.temp = 32            # suhu baterai
        self.speed = 61.0
        self.current_tab = "Whole Car"
        self.car_pixmap, self.car_clean = load_car()
        self._cache = {}
        self.setMinimumSize(S(240), S(200))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    # ---------------- data ----------------
    def set_data(self, tpms, soc, temp, speed=61.0):
        self.tpms = tpms
        self.soc = soc
        self.temp = temp
        self.speed = speed
        self.update()

    def set_tab(self, tab_name):
        self.current_tab = tab_name
        self.update()

    # ---------------- helpers ----------------
    def _car(self, max_w, max_h):
        """Foto mobil di-scale. Kalau latar gagal dihapus, tepinya dibuat memudar."""
        if not self.car_pixmap:
            return None
        key = (int(max_w), int(max_h))
        if key in self._cache:
            return self._cache[key]
        if len(self._cache) > 8:
            self._cache.clear()

        sc = self.car_pixmap.scaled(key[0], key[1], Qt.KeepAspectRatio, Qt.SmoothTransformation)
        if self.car_clean:
            self._cache[key] = sc
            return sc

        out = QPixmap(sc.size())
        out.fill(Qt.transparent)
        q = QPainter(out)
        q.setRenderHint(QPainter.SmoothPixmapTransform)
        q.drawPixmap(0, 0, sc)
        q.setCompositionMode(QPainter.CompositionMode_DestinationOut)

        W, H = float(sc.width()), float(sc.height())
        fx, fy = W * 0.16, H * 0.07

        def fade(rect, x1, y1, x2, y2):
            g = QLinearGradient(x1, y1, x2, y2)
            g.setColorAt(0.0, QColor(0, 0, 0, 255))
            g.setColorAt(1.0, QColor(0, 0, 0, 0))
            q.fillRect(rect, QBrush(g))

        fade(QRectF(0, 0, fx, H), 0, 0, fx, 0)
        fade(QRectF(W - fx, 0, fx, H), W, 0, W - fx, 0)
        fade(QRectF(0, 0, W, fy), 0, 0, 0, fy)
        fade(QRectF(0, H - fy, W, fy), 0, H, 0, H - fy)
        q.end()

        self._cache[key] = out
        return out

    def _glow(self, p, cx, cy, radius, alpha=42):
        """Glow cyan melingkar yang sudah memudar penuh sebelum menyentuh tepi area."""
        g = QRadialGradient(QPointF(cx, cy), radius)
        g.setColorAt(0.0, QColor(56, 189, 248, alpha))
        g.setColorAt(0.6, QColor(56, 189, 248, int(alpha * 0.35)))
        g.setColorAt(1.0, QColor(56, 189, 248, 0))
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(g))
        p.drawEllipse(QPointF(cx, cy), radius, radius)

    def _vbar(self, p, x, y, bw, bh, ratio, color, icon, value, label, k):
        ratio = max(0.0, min(1.0, ratio))
        cx = x + bw / 2

        draw_icon(p, icon, QRectF(cx - 10 * k, y - 36 * k, 20 * k, 20 * k), "#cbd5e1")

        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#14213d"))
        p.drawRoundedRect(QRectF(x, y, bw, bh), bw / 2, bw / 2)

        fh = bh * ratio
        if fh > 1:
            glow = QColor(color)
            glow.setAlpha(45)
            p.setBrush(glow)
            gw = bw + 6 * k
            p.drawRoundedRect(QRectF(x - 3 * k, y + bh - fh - 3 * k, gw, fh + 6 * k), gw / 2, gw / 2)

            g = QLinearGradient(0, y + bh, 0, y)
            g.setColorAt(0.0, color.darker(110))
            g.setColorAt(1.0, color.lighter(135))
            p.setBrush(QBrush(g))
            p.drawRoundedRect(QRectF(x, y + bh - fh, bw, fh), bw / 2, bw / 2)

        p.setPen(QColor("#ffffff"))
        p.setFont(font(14, True))
        p.drawText(QRectF(cx - 45 * k, y + bh + 8 * k, 90 * k, 20 * k), Qt.AlignCenter, value)
        p.setPen(QColor(GRAY))
        p.setFont(font(10, True))
        p.drawText(QRectF(cx - 45 * k, y + bh + 28 * k, 90 * k, 14 * k), Qt.AlignCenter, label)

    def _chip(self, p, rect, title, value, color, ratio, k):
        """Kartu metrik tab Engine: judul, nilai, bar rasio tipis."""
        p.setPen(QPen(QColor("#1e293b"), 1))
        p.setBrush(QColor("#0f172a"))
        p.drawRoundedRect(rect, 10 * k, 10 * k)

        x, y, w = rect.x() + 14 * k, rect.y(), rect.width() - 28 * k
        p.setPen(QColor(GRAY))
        p.setFont(font(11, True))
        p.drawText(QRectF(x, y + 10 * k, w, 16 * k), Qt.AlignLeft | Qt.AlignVCenter, title)
        p.setPen(QColor("#ffffff"))
        p.setFont(font(24, True))
        p.drawText(QRectF(x, y + 28 * k, w, 34 * k), Qt.AlignLeft | Qt.AlignVCenter, value)

        by = rect.bottom() - 16 * k
        bh = 5 * k
        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#1e293b"))
        p.drawRoundedRect(QRectF(x, by, w, bh), bh / 2, bh / 2)
        ratio = max(0.0, min(1.0, ratio))
        if ratio > 0.01:
            p.setBrush(QColor(color))
            p.drawRoundedRect(QRectF(x, by, w * ratio, bh), bh / 2, bh / 2)

    # ---------------- paint ----------------
    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)

        w, h = float(self.width()), float(self.height())
        k = UI["scale"]

        if self.current_tab == "Engine":
            self._paint_engine(p, w, h, k)
        elif self.current_tab == "Wheels":
            self._paint_wheels(p, w, h, k)
        else:
            self._paint_car(p, w, h, k)

    # ---------- TAB: WHOLE CAR ----------
    def _paint_car(self, p, w, h, k):
        margin = 6 * k
        area_h = h - margin * 2
        cx = w / 2

        pix = self._car(w * 0.50, area_h * 0.96)
        if pix:
            iw, ih = float(pix.width()), float(pix.height())
        else:
            iw, ih = area_h * 0.45, area_h * 0.9
        ix = cx - iw / 2
        iy = margin + (area_h - ih) / 2

        self._glow(p, cx, iy + ih / 2, min(w * 0.42, area_h * 0.50))

        if pix:
            p.drawPixmap(int(ix), int(iy), pix)
        else:
            p.setPen(QPen(QColor("#334155"), 2))
            p.setBrush(Qt.NoBrush)
            p.drawRoundedRect(QRectF(ix, iy, iw, ih), 22, 22)

        # bar baterai (kiri) & suhu baterai (kanan)
        bar_w = 10 * k
        bar_h = min(ih * 0.62, area_h * 0.58)
        bar_y = iy + (ih - bar_h) / 2 - 6 * k
        x_l = max(w * 0.09, cx - iw / 2 - w * 0.14)
        x_r = min(w * 0.91 - bar_w, cx + iw / 2 + w * 0.14 - bar_w)

        soc_col = QColor(RED if self.soc < 20 else (AMBER if self.soc < 40 else CYAN))
        tmp_col = QColor(RED if self.temp >= 55 else (AMBER if self.temp >= 45 else CYAN))

        self._vbar(p, x_l, bar_y, bar_w, bar_h, self.soc / 100.0, soc_col,
                   "battery", f"{self.soc}%", "BATERAI", k)
        self._vbar(p, x_r, bar_y, bar_w, bar_h, min(60.0, self.temp) / 60.0, tmp_col,
                   "thermo", f"{int(self.temp)}°C", "SUHU BATT", k)

    # ---------- TAB: ENGINE (ringkas, 2x2) ----------
    def _paint_engine(self, p, w, h, k):
        margin = 12 * k
        gap = 10 * k
        title_h = 30 * k
        bar_block = 44 * k

        rpm = int(self.speed * 42.5)
        motor_temp = min(95, int(35 + self.speed * 0.4))
        pwr_kw = round(self.speed * 0.15, 1)
        load = max(0.0, min(1.0, self.speed / MAX_SPEED))

        metrics = [
            ("PUTARAN MOTOR", f"{rpm} RPM", CYAN, rpm / 7650.0),
            ("SUHU MOTOR", f"{motor_temp}°C", GREEN if motor_temp < 80 else RED, motor_temp / 100.0),
            ("OUTPUT DAYA", f"{pwr_kw} kW", CYAN, pwr_kw / 30.0),
            ("EFISIENSI", "94.2%", GREEN, 0.942),
        ]

        avail = h - margin * 2 - title_h - bar_block - gap * 2
        card_h = max(84 * k, min(112 * k, avail / 2))
        used = title_h + 2 * card_h + gap * 2 + bar_block
        y0 = margin + max(0.0, (h - margin * 2 - used) / 2)

        p.setPen(QColor("#ffffff"))
        p.setFont(font(13, True))
        p.drawText(QRectF(0, y0, w, 22 * k), Qt.AlignCenter, "STATUS MOTOR PENGGERAK")

        top = y0 + title_h
        card_w = (w - margin * 2 - gap) / 2
        for idx, (title, val, col, ratio) in enumerate(metrics):
            rx = margin + (idx % 2) * (card_w + gap)
            ry = top + (idx // 2) * (card_h + gap)
            self._chip(p, QRectF(rx, ry, card_w, card_h), title, val, col, ratio, k)

        cards_end = top + 2 * card_h + gap
        label_y = cards_end + gap
        by = label_y + 22 * k

        p.setPen(QColor(GRAY))
        p.setFont(font(11, True))
        p.drawText(QRectF(margin, label_y, w / 2, 18 * k), Qt.AlignLeft | Qt.AlignVCenter, "BEBAN MOTOR")
        p.setPen(QColor("#ffffff"))
        p.drawText(QRectF(w / 2, label_y, w / 2 - margin, 18 * k), Qt.AlignRight | Qt.AlignVCenter,
                   f"{load * 100:.0f}%")

        bar_h = 10 * k
        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#1e293b"))
        p.drawRoundedRect(QRectF(margin, by, w - margin * 2, bar_h), bar_h / 2, bar_h / 2)
        if load > 0.01:
            g = QLinearGradient(margin, 0, w - margin, 0)
            g.setColorAt(0, QColor(CYAN))
            g.setColorAt(0.7, QColor(AMBER))
            g.setColorAt(1, QColor(RED))
            p.setBrush(QBrush(g))
            p.drawRoundedRect(QRectF(margin, by, (w - margin * 2) * load, bar_h), bar_h / 2, bar_h / 2)

    # ---------- TAB: WHEELS ----------
    def _paint_wheels(self, p, w, h, k):
        margin = 12 * k
        cx = w / 2
        p.setPen(QColor("#ffffff"))
        p.setFont(font(13, True))
        p.drawText(QRectF(0, margin, w, 22 * k), Qt.AlignCenter, "TEKANAN BAN (TPMS)")

        top = margin + 34 * k
        status_h = 30 * k
        avail_h = h - top - status_h - margin

        box_h = min(avail_h, 340 * k)
        box_w = box_h * 0.62
        bx = cx - box_w / 2
        by = top + (avail_h - box_h) / 2

        self._glow(p, cx, by + box_h / 2, min(w * 0.40, avail_h * 0.50), 40)

        p.setPen(QPen(QColor("#334155"), 2, Qt.DashLine))
        p.setBrush(Qt.NoBrush)
        p.drawRoundedRect(QRectF(bx, by, box_w, box_h), 16 * k, 16 * k)

        pix = self._car(box_w * 0.95, box_h * 0.97)
        if pix:
            p.setOpacity(0.75)
            p.drawPixmap(int(cx - pix.width() / 2), int(by + (box_h - pix.height()) / 2), pix)
            p.setOpacity(1.0)

        bw, bh = 56 * k, 62 * k
        left_x = bx - bw * 0.62
        right_x = bx + box_w - bw * 0.38
        top_y = by + box_h * 0.06
        bot_y = by + box_h * 0.94 - bh
        wheels = [
            (left_x, top_y, "FL", self.tpms[0]),
            (right_x, top_y, "FR", self.tpms[1]),
            (left_x, bot_y, "RL", self.tpms[2]),
            (right_x, bot_y, "RR", self.tpms[3]),
        ]

        all_ok = True
        for wx, wy, label, psi in wheels:
            if 30 <= psi <= 40:
                col, bg = GREEN, "#062016"
            elif 25 <= psi <= 45:
                col, bg, all_ok = AMBER, "#2a1a04", False
            else:
                col, bg, all_ok = RED, "#2a0a0a", False

            p.setPen(QPen(QColor(col), 1.6))
            p.setBrush(QColor(bg))
            p.drawRoundedRect(QRectF(wx, wy, bw, bh), 10 * k, 10 * k)

            p.setPen(QColor("#94a3b8"))
            p.setFont(font(11, True))
            p.drawText(QRectF(wx, wy + 5 * k, bw, 14 * k), Qt.AlignCenter, label)
            p.setPen(QColor(col))
            p.setFont(font(18, True))
            p.drawText(QRectF(wx, wy + 21 * k, bw, 24 * k), Qt.AlignCenter, str(psi))
            p.setPen(QColor(GRAY))
            p.setFont(font(9, True))
            p.drawText(QRectF(wx, wy + 45 * k, bw, 12 * k), Qt.AlignCenter, "PSI")

        p.setPen(QColor(GREEN if all_ok else AMBER))
        p.setFont(font(11, True))
        msg = ("Semua roda dalam tekanan ideal (30-40 PSI)" if all_ok
               else "Periksa ban yang berwarna kuning / merah")
        p.drawText(QRectF(0, h - margin - status_h, w, status_h), Qt.AlignCenter, msg)


