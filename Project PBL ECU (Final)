def current_color(v):
    """Warna busur arus mengikuti status: normal / waspada / tinggi."""
    return RED if v >= 100 else (AMBER if v >= 80 else CYAN)


def voltage_color(v):
    """Warna busur tegangan mengikuti status: normal / waspada / rendah-tinggi."""
    if v < 62 or v > 84:
        return RED
    return AMBER if v < 66 else CYAN


class ArcMeter(QWidget):
    """Gauge busur 270 derajat (gaya sama dengan speedometer), animasi halus, warna sesuai status."""
    START = 225.0
    SPAN = 270.0

    def __init__(self, val_unit="A", max_val=120, color=CYAN, color_fn=None, parent=None):
        super().__init__(parent)
        self.value = 0.0            # nilai yang digambar (dianimasikan)
        self.target = 0.0           # nilai sebenarnya
        self.val_unit = val_unit
        self.max_val = max_val
        self.color = QColor(color)
        self.color_fn = color_fn
        self.setMinimumSize(S(130), S(130))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self._anim = QTimer(self)
        self._anim.setInterval(16)
        self._anim.timeout.connect(self._step)

    def sizeHint(self):
        return QSize(S(200), S(190))

    def set_value(self, v):
        self.target = max(0.0, min(float(self.max_val), v))
        if not self._anim.isActive() and abs(self.target - self.value) > 0.02:
            self._anim.start()

    def _step(self):
        diff = self.target - self.value
        if abs(diff) < max(0.02, self.max_val * 0.0005):
            self.value = self.target
            self._anim.stop()
        else:
            self.value += diff * 0.22
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        label_h = S(16)

        # busur 270 derajat butuh tinggi ~1.707*r (bagian bawah terbuka); label batas di ujung busur
        r0 = min(w / 2.0, (h - label_h) / 1.707)
        pw = max(S(8), r0 * 0.11)
        r = max(S(30), min((w - pw) / 2.0 - S(2), (h - pw - label_h) / 1.707))
        cx = w / 2.0
        cy = h / 2.0 + 0.146 * r - label_h / 2.0       # pusatkan blok busur + label secara vertikal
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1e293b"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, int(self.START * 16), int(-self.SPAN * 16))

        ratio = self.value / self.max_val if self.max_val else 0.0
        if ratio * self.SPAN > 2.0:
            col = QColor(self.color_fn(self.value)) if self.color_fn else self.color
            p.setPen(QPen(col, pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, int(self.START * 16), int(-self.SPAN * ratio * 16))

            a = math.radians(self.START - self.SPAN * ratio)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#ffffff"))
            p.drawEllipse(QPointF(cx + r * math.cos(a), cy - r * math.sin(a)), pw * 0.6, pw * 0.6)

        # angka (data sebenarnya) + satuan di tengah, seperti speedometer
        p.setPen(QColor("#ffffff"))
        p.setFont(rfont(r * 0.40, True))
        p.drawText(QRectF(cx - r, cy - r * 0.55, 2 * r, r * 0.62), Qt.AlignCenter, f"{self.target:.1f}")
        p.setPen(QColor(GRAY))
        p.setFont(rfont(r * 0.19, True))
        p.drawText(QRectF(cx - r, cy + r * 0.14, 2 * r, r * 0.28), Qt.AlignCenter, self.val_unit)

        # batas skala di bawah ujung busur
        p.setFont(font(11))
        ex = r * 0.7071
        ey = cy + ex + pw / 2 + S(2)
        p.drawText(QRectF(cx - ex - S(24), ey, S(48), label_h), Qt.AlignCenter, "0")
        p.drawText(QRectF(cx + ex - S(24), ey, S(48), label_h), Qt.AlignCenter, str(self.max_val))


class SpeedGauge(QWidget):
    START = 225.0
    SPAN = 270.0

    def __init__(self, parent=None):
        super().__init__(parent)
        self.value = 0.0            # nilai yang digambar (dianimasikan)
        self.target = 0.0           # nilai sebenarnya
        # lampu sein & hazard (kedipan dibuat di sini, ~1,5 Hz)
        self.sig_left = False
        self.sig_right = False
        self.sig_hazard = False
        self._phase = True
        self._blink_timer = QTimer(self)
        self._blink_timer.setInterval(330)
        self._blink_timer.timeout.connect(self._on_blink)
        self._blink_timer.start()
        self._anim = QTimer(self)
        self._anim.setInterval(16)
        self._anim.timeout.connect(self._step)
        self.setMinimumSize(S(180), S(180))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, v):
        self.target = max(0.0, min(float(MAX_SPEED), v))
        if not self._anim.isActive() and abs(self.target - self.value) > 0.05:
            self._anim.start()

    def _step(self):
        diff = self.target - self.value
        if abs(diff) < 0.05:
            self.value = self.target
            self._anim.stop()
        else:
            self.value += diff * 0.22
        self.update()

    def _on_blink(self):
        self._phase = not self._phase
        if self.sig_left or self.sig_right or self.sig_hazard:
            self.update()

    def set_signals(self, left, right, hazard):
        left, right, hazard = bool(left), bool(right), bool(hazard)
        if (left, right, hazard) == (self.sig_left, self.sig_right, self.sig_hazard):
            return
        was_active = self.sig_left or self.sig_right or self.sig_hazard
        self.sig_left, self.sig_right, self.sig_hazard = left, right, hazard
        if not was_active and (left or right or hazard):
            self._phase = True              # mulai dari kondisi menyala
            self._blink_timer.start()       # restart timer supaya kedipan tersinkron
        self.update()

    def _draw_signals(self, p, cx, cy, s):
        """Sein kiri, hazard, sein kanan di celah bawah speedometer. Redup saat mati."""
        u = s * 0.045
        y = cy + s * 0.355
        dx = s * 0.175
        lit_left = (self.sig_left or self.sig_hazard) and self._phase
        lit_right = (self.sig_right or self.sig_hazard) and self._phase
        lit_haz = self.sig_hazard and self._phase

        base = [(-1.0, 0.0), (-0.15, -0.8), (-0.15, -0.35), (1.0, -0.35),
                (1.0, 0.35), (-0.15, 0.35), (-0.15, 0.8)]      # panah menunjuk ke kiri

        def glow(x, color):
            g = QRadialGradient(QPointF(x, y), u * 2.6)
            c1 = QColor(color)
            c1.setAlpha(130)
            c0 = QColor(color)
            c0.setAlpha(0)
            g.setColorAt(0.0, c1)
            g.setColorAt(1.0, c0)
            p.setPen(Qt.NoPen)
            p.setBrush(QBrush(g))
            p.drawEllipse(QPointF(x, y), u * 2.6, u * 2.6)

        def arrow(x, m, lit):
            path = QPainterPath()
            for i, (px_, py_) in enumerate(base):
                pt = QPointF(x + m * px_ * u, y + py_ * u)
                if i == 0:
                    path.moveTo(pt)
                else:
                    path.lineTo(pt)
            path.closeSubpath()
            if lit:
                glow(x, GREEN)
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(GREEN))
            else:
                p.setPen(QPen(QColor("#3b4f78"), 1.2))
                p.setBrush(QColor("#1e2d4a"))
            p.drawPath(path)

        arrow(cx - dx, 1.0, lit_left)
        arrow(cx + dx, -1.0, lit_right)

        tri = QPainterPath()
        tri.moveTo(cx, y - u * 1.0)
        tri.lineTo(cx + u * 1.1, y + u * 0.8)
        tri.lineTo(cx - u * 1.1, y + u * 0.8)
        tri.closeSubpath()
        if lit_haz:
            glow(cx, RED)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(RED))
        else:
            p.setPen(QPen(QColor("#3b4f78"), 1.2))
            p.setBrush(QColor("#1e2d4a"))
        p.drawPath(tri)
        p.setPen(QPen(QColor("#ffffff" if lit_haz else "#4a5f85"), max(1.5, u * 0.16),
                      Qt.SolidLine, Qt.RoundCap))
        p.drawLine(QPointF(cx, y - u * 0.35), QPointF(cx, y + u * 0.2))
        p.drawLine(QPointF(cx, y + u * 0.5), QPointF(cx, y + u * 0.52))

    def _pt(self, cx, cy, rad, v):
        a = math.radians(self.START - self.SPAN * v / MAX_SPEED)
        return QPointF(cx + rad * math.cos(a), cy - rad * math.sin(a))

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        s = min(w, h)
        cx, cy = w / 2, h / 2
        pw = s * 0.045
        r = s / 2 - pw / 2 - 4
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1e293b"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, int(self.START * 16), int(-self.SPAN * 16))

        for lo, hi, col in ((ZONE_WARN, ZONE_RED, AMBER), (ZONE_RED, MAX_SPEED, RED)):
            a0 = self.START - self.SPAN * lo / MAX_SPEED
            span = -self.SPAN * (hi - lo) / MAX_SPEED
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.FlatCap))
            p.drawArc(rect, int(a0 * 16), int(span * 16))

        # busur nilai baru digambar kalau sudah cukup panjang (hindari gumpalan di 0 km/h)
        if self.value > 3.0:
            col = RED if self.value >= ZONE_RED else (AMBER if self.value >= ZONE_WARN else CYAN)
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, int(self.START * 16), int(-self.SPAN * (self.value / MAX_SPEED) * 16))

        r_in = r - pw / 2 - s * 0.025
        for v in range(0, MAX_SPEED + 1, 10):
            major = v % 30 == 0
            ln = s * (0.045 if major else 0.025)
            p.setPen(QPen(QColor("#cbd5e1" if major else "#334155"), 2.0 if major else 1.0))
            p.drawLine(self._pt(cx, cy, r_in, v), self._pt(cx, cy, r_in - ln, v))
            if major:
                lp = self._pt(cx, cy, r_in - s * 0.09, v)
                p.setFont(rfont(s * 0.042, True))
                p.setPen(QColor("#cbd5e1"))
                p.drawText(QRectF(lp.x() - 22, lp.y() - 11, 44, 22), Qt.AlignCenter, str(v))

        # angka kecepatan memakai data sebenarnya (busur dianimasikan, angka tidak tertinggal)
        p.setPen(QColor("#ffffff"))
        p.setFont(rfont(s * 0.30, True))
        p.drawText(QRectF(0, cy - s * 0.22, w, s * 0.32), Qt.AlignCenter, str(int(round(self.target))))
        p.setPen(QColor(GRAY))
        p.setFont(rfont(s * 0.062, True))
        p.drawText(QRectF(0, cy + s * 0.11, w, s * 0.08), Qt.AlignCenter, "km/h")

        self._draw_signals(p, cx, cy, s)


class EnergyChart(QWidget):
    """Grafik konsumsi energi: kurva halus + area gradient + garis rata-rata, skala otomatis."""

    def __init__(self, parent=None):
        super().__init__(parent)
        # jendela ~20 detik (40 titik x 0,5 detik)
        self.values = deque([20.0 + 3.5 * math.sin(i / 3.0) for i in range(40)], maxlen=40)
        self._lo, self._hi = 0.0, 50.0
        self._retarget(snap=True)
        self.setMinimumHeight(S(80))

    def average(self):
        return sum(self.values) / float(len(self.values))

    def _retarget(self, snap=False):
        lo, hi = min(self.values), max(self.values)
        span = max(hi - lo, 12.0)
        mid = (hi + lo) / 2.0
        t_lo, t_hi = mid - span * 0.7, mid + span * 0.7
        if snap:
            self._lo, self._hi = t_lo, t_hi
        else:
            self._lo += (t_lo - self._lo) * 0.2
            self._hi += (t_hi - self._hi) * 0.2

    def add_value(self, val):
        self.values.append(float(val))
        self._retarget()
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = float(self.width()), float(self.height())

        vals = list(self.values)
        pad = 6.0
        top, bottom = 10.0, 8.0
        plot_h = h - top - bottom
        span = max(self._hi - self._lo, 1e-6)

        def ypos(v):
            t = (v - self._lo) / span
            return top + (1.0 - max(0.0, min(1.0, t))) * plot_h

        ya = ypos(self.average())
        p.setPen(QPen(QColor("#334155"), 1, Qt.DashLine))
        p.drawLine(QPointF(pad, ya), QPointF(w - pad, ya))

        if len(vals) < 2:
            return

        n = len(vals)
        step = (w - 2 * pad) / (n - 1)
        pts = [QPointF(pad + i * step, ypos(v)) for i, v in enumerate(vals)]

        path = QPainterPath(pts[0])
        for i in range(1, n):
            mx = (pts[i - 1].x() + pts[i].x()) / 2
            path.cubicTo(QPointF(mx, pts[i - 1].y()), QPointF(mx, pts[i].y()), pts[i])

        area = QPainterPath(path)
        area.lineTo(QPointF(pts[-1].x(), top + plot_h))
        area.lineTo(QPointF(pts[0].x(), top + plot_h))
        area.closeSubpath()
        g = QLinearGradient(0, top, 0, top + plot_h)
        g.setColorAt(0.0, QColor(56, 189, 248, 80))
        g.setColorAt(1.0, QColor(56, 189, 248, 0))
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(g))
        p.drawPath(area)

        p.setPen(QPen(QColor(CYAN), 2.0, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
        p.setBrush(Qt.NoBrush)
        p.drawPath(path)

        last = pts[-1]
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(56, 189, 248, 60))
        p.drawEllipse(last, 7, 7)
        p.setBrush(QColor(CYAN))
        p.drawEllipse(last, 3.5, 3.5)


class ConsumptionCard(QFrame):
    """Kartu konsumsi energi + indikator gigi P R N D."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("card")
        self.setStyleSheet(card_style())
        self.current_gear = "D"
        self._ema = 20.0          # nilai terhaluskan (moving average eksponensial)
        self._t_last = 0.0

        lay = QVBoxLayout(self)
        lay.setContentsMargins(S(16), S(12), S(16), S(12))
        lay.setSpacing(S(6))

        head = QHBoxLayout()
        left = QVBoxLayout()
        left.setSpacing(S(1))
        row, _ = make_card_head("chart", "Konsumsi Energi", CYAN)
        left.addLayout(row)
        self.lbl_avg = QLabel("Rata-rata 20 Wh")
        self.lbl_avg.setStyleSheet(label_qss(SUBTLE, 12, False, f"margin-left: {S(24)}px;"))
        left.addWidget(self.lbl_avg)
        self.lbl_cur = QLabel("20 Wh")
        self.lbl_cur.setStyleSheet(label_qss(CYAN, 22, True))
        head.addLayout(left, 1)
        head.addWidget(self.lbl_cur, 0, Qt.AlignTop)

        self.chart = EnergyChart()

        row_gear = QHBoxLayout()
        row_gear.setContentsMargins(S(6), 0, S(6), 0)
        self.lbl_p = QLabel("P")
        self.lbl_r = QLabel("R")
        self.lbl_n = QLabel("N")
        self.lbl_d = QLabel("D")
        for i, lbl in enumerate((self.lbl_p, self.lbl_r, self.lbl_n, self.lbl_d)):
            lbl.setFixedSize(S(40), S(30))
            lbl.setAlignment(Qt.AlignCenter)
            if i:
                row_gear.addStretch()
            row_gear.addWidget(lbl)

        lay.addLayout(head)
        lay.addWidget(self.chart, 1)
        lay.addLayout(row_gear)
        self.set_gear("D")
        self._refresh_labels()

    def _refresh_labels(self):
        self.lbl_cur.setText(f"{self.chart.values[-1]:.0f} Wh")
        self.lbl_avg.setText(f"Rata-rata {self.chart.average():.0f} Wh")

    def add_value(self, v):
        # haluskan derau, lalu ambil sampel grafik tiap 0,5 detik
        self._ema = 0.85 * self._ema + 0.15 * v
        now = time.monotonic()
        if now - self._t_last >= 0.5:
            self._t_last = now
            self.chart.add_value(self._ema)
            self._refresh_labels()

    def set_gear(self, gear):
        if gear == self.current_gear and getattr(self, "_gear_init", False):
            return
        self._gear_init = True
        self.current_gear = gear
        gears = {"P": self.lbl_p, "R": self.lbl_r, "N": self.lbl_n, "D": self.lbl_d}
        for g_key, lbl in gears.items():
            if g_key == gear:
                lbl.setStyleSheet(f"background-color: #0c4a6e; color: #38bdf8; border: 1px solid #0284c7; "
                                  f"border-radius: {S(9)}px; font-size: {S(16)}px; font-weight: bold;")
            else:
                lbl.setStyleSheet(f"background: transparent; color: #64748b; border: none; "
                                  f"font-size: {S(14)}px; font-weight: bold;")


