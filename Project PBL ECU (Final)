class ArcMeter(QWidget):
    def __init__(self, val_unit="A", max_val=120, color=CYAN, parent=None):
        super().__init__(parent)
        self.value = 0.0
        self.val_unit = val_unit
        self.max_val = max_val
        self.color = QColor(color)
        self.setMinimumSize(S(120), S(80))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, v):
        self.value = max(0.0, min(float(self.max_val), v))
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        cx = w / 2
        r = max(S(30), min(w / 2 - S(20), h - S(44)))
        pw = max(S(7), r * 0.09)

        # blok gauge (busur + label batas) dipusatkan secara vertikal
        block_h = r + pw + S(22)
        y_top = max(0.0, (h - block_h) / 2)
        cy = y_top + pw / 2 + r
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1e293b"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, 0 * 16, 180 * 16)

        if self.value > 0.05:
            ratio = self.value / self.max_val
            span_deg = ratio * 180
            p.setPen(QPen(self.color, pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, 180 * 16, int(-span_deg * 16))

            angle_rad = math.radians(180 - span_deg)
            dot_x = cx + r * math.cos(angle_rad)
            dot_y = cy - r * math.sin(angle_rad)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#ffffff"))
            p.drawEllipse(QPointF(dot_x, dot_y), pw * 0.6, pw * 0.6)

        p.setPen(QColor("#ffffff"))
        p.setFont(rfont(r * 0.27, True))
        p.drawText(QRectF(0, cy - r * 0.62, w, r * 0.40), Qt.AlignCenter, f"{self.value:.1f} {self.val_unit}")

        p.setPen(QColor(GRAY))
        p.setFont(font(10))
        p.drawText(QRectF(cx - r - pw, cy + S(6), S(50), S(14)), Qt.AlignLeft, "0" + self.val_unit)
        p.drawText(QRectF(cx + r - S(50) + pw, cy + S(6), S(50), S(14)), Qt.AlignRight,
                   f"{self.max_val}" + self.val_unit)


class SpeedGauge(QWidget):
    START = 225.0
    SPAN = 270.0

    def __init__(self, parent=None):
        super().__init__(parent)
        self.value = 61.0
        self.setMinimumSize(S(180), S(180))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, v):
        self.value = max(0.0, min(float(MAX_SPEED), v))
        self.update()

    def _pt(self, cx, cy, rad, v):
        a = math.radians(self.START - self.SPAN * v / MAX_SPEED)
        return QPointF(cx + rad * math.cos(a), cy - rad * math.sin(a))

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)

        w, h = self.width(), self.height()
        s = min(w, h)
        cx, cy = w / 2, h / 2
        pw = s * 0.045
        r = s / 2 - pw / 2 - 4
        rect = QRectF(cx - r, cy - r, 2 * r, 2 * r)

        p.setPen(QPen(QColor("#1e293b"), pw, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(rect, int(self.START * 16), int(-self.SPAN * 16))

        for lo, hi, col in ((ZONE_WARN, ZONE_RED, AMBER), (ZONE_RED, MAX_SPEED, RED)):
            a0 = self.START - self.SPAN * lo / MAX_SPEED
            span = -self.SPAN * (hi - lo) / MAX_SPEED
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.FlatCap))
            p.drawArc(rect, int(a0 * 16), int(span * 16))

        # busur nilai baru digambar kalau sudah cukup panjang (hindari gumpalan di 0 km/h)
        if self.value > 3.0:
            col = RED if self.value >= ZONE_RED else (AMBER if self.value >= ZONE_WARN else CYAN)
            p.setPen(QPen(QColor(col), pw, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(rect, int(self.START * 16), int(-self.SPAN * (self.value / MAX_SPEED) * 16))

        r_in = r - pw / 2 - s * 0.025
        for v in range(0, MAX_SPEED + 1, 10):
            major = v % 30 == 0
            ln = s * (0.045 if major else 0.025)
            p.setPen(QPen(QColor("#cbd5e1" if major else "#334155"), 2.0 if major else 1.0))
            p.drawLine(self._pt(cx, cy, r_in, v), self._pt(cx, cy, r_in - ln, v))
            if major:
                lp = self._pt(cx, cy, r_in - s * 0.09, v)
                p.setFont(rfont(s * 0.040, True))
                p.setPen(QColor("#cbd5e1"))
                p.drawText(QRectF(lp.x() - 20, lp.y() - 10, 40, 20), Qt.AlignCenter, str(v))

        p.setPen(QColor("#94a3b8"))
        p.setFont(rfont(s * 0.038, True))
        p.drawText(QRectF(0, cy - s * 0.25, w, s * 0.06), Qt.AlignCenter, "KECEPATAN")
        p.setPen(QColor("#ffffff"))
        p.setFont(rfont(s * 0.28, True))
        p.drawText(QRectF(0, cy - s * 0.18, w, s * 0.30), Qt.AlignCenter, str(int(self.value)))
        p.setPen(QColor(GRAY))
        p.setFont(rfont(s * 0.06, True))
        p.drawText(QRectF(0, cy + s * 0.14, w, s * 0.08), Qt.AlignCenter, "km/h")


class EnergyChart(QWidget):
    """Grafik konsumsi energi: kurva halus + area gradient + garis rata-rata, skala otomatis."""

    def __init__(self, parent=None):
        super().__init__(parent)
        # jendela ~20 detik (40 titik x 0,5 detik)
        self.values = deque([20.0 + 3.5 * math.sin(i / 3.0) for i in range(40)], maxlen=40)
        self._lo, self._hi = 0.0, 50.0
        self._retarget(snap=True)
        self.setMinimumHeight(S(80))

    def average(self):
        return sum(self.values) / float(len(self.values))

    def _retarget(self, snap=False):
        lo, hi = min(self.values), max(self.values)
        span = max(hi - lo, 12.0)
        mid = (hi + lo) / 2.0
        t_lo, t_hi = mid - span * 0.7, mid + span * 0.7
        if snap:
            self._lo, self._hi = t_lo, t_hi
        else:
            self._lo += (t_lo - self._lo) * 0.2
            self._hi += (t_hi - self._hi) * 0.2

    def add_value(self, val):
        self.values.append(float(val))
        self._retarget()
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = float(self.width()), float(self.height())

        vals = list(self.values)
        pad = 6.0
        top, bottom = 10.0, 8.0
        plot_h = h - top - bottom
        span = max(self._hi - self._lo, 1e-6)

        def ypos(v):
            t = (v - self._lo) / span
            return top + (1.0 - max(0.0, min(1.0, t))) * plot_h

        ya = ypos(self.average())
        p.setPen(QPen(QColor("#334155"), 1, Qt.DashLine))
        p.drawLine(QPointF(pad, ya), QPointF(w - pad, ya))

        if len(vals) < 2:
            return

        n = len(vals)
        step = (w - 2 * pad) / (n - 1)
        pts = [QPointF(pad + i * step, ypos(v)) for i, v in enumerate(vals)]

        path = QPainterPath(pts[0])
        for i in range(1, n):
            mx = (pts[i - 1].x() + pts[i].x()) / 2
            path.cubicTo(QPointF(mx, pts[i - 1].y()), QPointF(mx, pts[i].y()), pts[i])

        area = QPainterPath(path)
        area.lineTo(QPointF(pts[-1].x(), top + plot_h))
        area.lineTo(QPointF(pts[0].x(), top + plot_h))
        area.closeSubpath()
        g = QLinearGradient(0, top, 0, top + plot_h)
        g.setColorAt(0.0, QColor(56, 189, 248, 80))
        g.setColorAt(1.0, QColor(56, 189, 248, 0))
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(g))
        p.drawPath(area)

        p.setPen(QPen(QColor(CYAN), 2.0, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
        p.setBrush(Qt.NoBrush)
        p.drawPath(path)

        last = pts[-1]
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(56, 189, 248, 60))
        p.drawEllipse(last, 7, 7)
        p.setBrush(QColor(CYAN))
        p.drawEllipse(last, 3.5, 3.5)


class ConsumptionCard(QFrame):
