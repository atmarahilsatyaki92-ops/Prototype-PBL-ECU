class EnergyRow(QWidget):
    """Satu baris metrik: ikon + nama + angka besar, bar tebal, sub-teks. Isi dipusatkan vertikal."""

    def __init__(self, icon, title, unit, max_value):
        super().__init__()
        self.unit = unit
        self.max_value = float(max_value)
        self._key = None
        self._bar_color = None
        self.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Expanding)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(S(6))

        top = QHBoxLayout()
        top.setSpacing(S(8))
        top.addWidget(IconWidget(icon, 18, GRAY))
        lbl_t = QLabel(title.upper())
        lbl_t.setStyleSheet(label_qss(GRAY, 12, True))
        top.addWidget(lbl_t)
        top.addStretch()
        self.lbl_val = QLabel()
        self.lbl_val.setTextFormat(Qt.RichText)
        top.addWidget(self.lbl_val)

        self.pbar = QProgressBar()
        self.pbar.setFixedHeight(S(8))
        self.pbar.setRange(0, 100)
        self.pbar.setTextVisible(False)

        sub = QHBoxLayout()
        self.lbl_sub_l = QLabel()
        self.lbl_sub_l.setStyleSheet(label_qss(SUBTLE, 12))
        self.lbl_sub_r = QLabel()
        self.lbl_sub_r.setStyleSheet(label_qss(SUBTLE, 12))
        sub.addWidget(self.lbl_sub_l)
        sub.addStretch()
        sub.addWidget(self.lbl_sub_r)

        lay.addStretch(1)
        lay.addLayout(top)
        lay.addWidget(self.pbar)
        lay.addLayout(sub)
        lay.addStretch(1)

    def update_data(self, val, sub_l, sub_r, color):
        key = (val, sub_l, sub_r, color)
        if key == self._key:
            return
        self._key = key
        sep = "" if self.unit == "%" else " "
        self.lbl_val.setText(
            f'<span style="font-size:{S(40)}px; font-weight:bold; color:#ffffff;">{val}</span>'
            f'<span style="font-size:{S(16)}px; font-weight:bold; color:#94a3b8;">{sep}{self.unit}</span>')
        self.pbar.setValue(int(max(0.0, min(100.0, val / self.max_value * 100.0))))
        if color != self._bar_color:
            self._bar_color = color
            self.pbar.setStyleSheet(
                f"QProgressBar {{ border: none; border-radius: {S(4)}px; background-color: #1e293b; }}"
                f"QProgressBar::chunk {{ background-color: {color}; border-radius: {S(4)}px; }}")
        self.lbl_sub_l.setText(sub_l)
        self.lbl_sub_r.setText(sub_r)


