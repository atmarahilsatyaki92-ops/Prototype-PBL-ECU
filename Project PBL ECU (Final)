    def update_status_pills(self, d, drive_mode, soc):
        # --- ban (TPMS): subjudul hanya muncul saat ada masalah ---
        tpms = d.get("tpms", [33, 33, 37, 37])
        names = ["FL", "FR", "RL", "RR"]
        bad = [(n, v) for n, v in zip(names, tpms) if not (30 <= v <= 40)]
        if not bad:
            self.pill_tire.set_state("SEMUA BAN NORMAL", "", NEUTRAL_SCHEME, GREEN)
        else:
            critical = any(v < 25 or v > 45 for _, v in bad)
            self.pill_tire.set_state("PERIKSA BAN", ", ".join(f"{n} {v} PSI" for n, v in bad),
                                     BAD_SCHEME if critical else WARN_SCHEME)

        # --- baterai: mode energi = info netral; amber/merah hanya jika SOC rendah ---
        em_key = d.get("energy_mode", "REGENERATIVE_READY")
        if drive_mode == "ICE":
            em_txt, _, _ = MODE_ENERGY_ICE.get(em_key, MODE_ENERGY_ICE["REGENERATIVE_READY"])
        else:
            em_txt, _, _ = MODE_ENERGY_EV.get(em_key, MODE_ENERGY_EV["IDLE"])
        if soc < 10:
            self.pill_bat.set_state(f"BATERAI KRITIS ({soc}%)", "segera isi daya", BAD_SCHEME)
        elif soc < 20:
            self.pill_bat.set_state(f"BATERAI RENDAH ({soc}%)", "segera isi daya", WARN_SCHEME)
        else:
            self.pill_bat.set_state(f"BATERAI: {em_txt}", "", NEUTRAL_SCHEME, CYAN)

        # --- keamanan (pintu & sabuk) ---
        door = bool(d.get("door", False))
        belt = bool(d.get("belt", True))
        if door and not belt:
            self.pill_sec.set_state("PINTU TERBUKA & SABUK BELUM DIPASANG", "", BAD_SCHEME)
        elif door:
            self.pill_sec.set_state("PINTU TERBUKA", "tutup pintu sebelum berkendara", BAD_SCHEME)
        elif not belt:
            self.pill_sec.set_state("SABUK BELUM DIPASANG", "pasang sabuk pengaman", WARN_SCHEME)
        else:
            self.pill_sec.set_state("KEAMANAN AMAN", "", NEUTRAL_SCHEME, GREEN)

    def render(self, d):
        speed = float(d["speed"])
        volt = float(d["voltage"])
        cur = float(d["current"])
        soc = int(d["soc"])
        fuel = float(d.get("fuel", 77.0))
        drive_mode = d.get("drive_mode", "ICE")
        tpms = d.get("tpms", [33, 33, 37, 37])
        gear = d.get("gear", "D")
        soh = int(d.get("soh", 94))
        est_range = int(d.get("est_range", 120))
        pwr = float(d.get("power", 0.0))
        bat_temp = float(d.get("bat_temp", 32.0))

        self.gauge.set_value(speed)
        self.meter_voltage.set_value(volt)
        self.meter_current.set_value(cur)
        self.lbl_power.setText(f"{pwr:.2f} kW")

        # status chip arus & tegangan
        if cur >= 100:
            self._set_chip(self.chip_i, "TINGGI", RED)
        elif cur >= 80:
            self._set_chip(self.chip_i, "WASPADA", AMBER)
        else:
            self._set_chip(self.chip_i, "NORMAL", GREEN)

        if volt < 62:
            self._set_chip(self.chip_v, "RENDAH", RED)
        elif volt < 66:
            self._set_chip(self.chip_v, "WASPADA", AMBER)
        elif volt > 84:
            self._set_chip(self.chip_v, "TINGGI", RED)
        else:
            self._set_chip(self.chip_v, "NORMAL", GREEN)

        # kartu energi gabungan: warna bar = status
        soh_col = GREEN if soh >= 80 else (AMBER if soh >= 60 else RED)
        soh_txt = "Kondisi baik" if soh >= 80 else ("Perlu dipantau" if soh >= 60 else "Perlu servis")
        self.card_energy.row_soh.update_data(soh, "State of Health", soh_txt, soh_col)

        rng_col = CYAN if est_range >= 30 else (AMBER if est_range >= 15 else RED)
        self.card_energy.row_range.update_data(est_range, "Sisa jarak tempuh",
                                               f"maks. {int(MAX_RANGE_KM)} km", rng_col)

        fuel_liters = round((fuel / 100.0) * FUEL_CAPACITY_LITERS, 1)
        fuel_col = CYAN if fuel >= 20 else (AMBER if fuel >= 10 else RED)
        self.card_energy.row_fuel.update_data(int(fuel), "Tangki Bensin",
                                              f"{fuel_liters} L / {FUEL_CAPACITY_LITERS} L", fuel_col)

        self.center_car.set_data(tpms, soc, bat_temp, speed)

        self.card_prnd.add_value(10 + (speed / 180.0) * 30 + random.randint(-4, 4))
        self.card_prnd.set_gear(gear)

        self.update_status_pills(d, drive_mode, soc)
        self._set_mode_buttons(drive_mode)


