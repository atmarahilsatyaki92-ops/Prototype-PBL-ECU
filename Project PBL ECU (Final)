class CarCenterViewDetailed(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.tpms = [33, 33, 37, 37]
        self.soc = 69
        self.temp = 28
        self.speed = 61.0
        self.current_tab = "Whole Car"
        self.car_pixmap, self.car_clean = load_car()
        self._cache = {}
        self.setMinimumSize(300, 260)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    # ---------------- data ----------------
    def set_data(self, tpms, soc, temp, speed=61.0):
        self.tpms = tpms
        self.soc = soc
        self.temp = temp
        self.speed = speed
        self.update()

    def set_tab(self, tab_name):
        self.current_tab = tab_name
        self.update()

    # ---------------- helpers ----------------
    def _car(self, max_w, max_h):
        """Foto mobil di-scale. Kalau latar gagal dihapus, tepinya dibuat memudar."""
        if not self.car_pixmap:
            return None
        key = (int(max_w), int(max_h))
        if key in self._cache:
            return self._cache[key]
        if len(self._cache) > 8:
            self._cache.clear()

        sc = self.car_pixmap.scaled(key[0], key[1], Qt.KeepAspectRatio, Qt.SmoothTransformation)
        if self.car_clean:
            self._cache[key] = sc
            return sc

        out = QPixmap(sc.size())
        out.fill(Qt.transparent)
        q = QPainter(out)
        q.setRenderHint(QPainter.SmoothPixmapTransform)
        q.drawPixmap(0, 0, sc)
        q.setCompositionMode(QPainter.CompositionMode_DestinationOut)

        W, H = float(sc.width()), float(sc.height())
        fx, fy = W * 0.16, H * 0.07

        def fade(rect, x1, y1, x2, y2):
            g = QLinearGradient(x1, y1, x2, y2)
            g.setColorAt(0.0, QColor(0, 0, 0, 255))
            g.setColorAt(1.0, QColor(0, 0, 0, 0))
            q.fillRect(rect, QBrush(g))

        fade(QRectF(0, 0, fx, H), 0, 0, fx, 0)
        fade(QRectF(W - fx, 0, fx, H), W, 0, W - fx, 0)
        fade(QRectF(0, 0, W, fy), 0, 0, 0, fy)
        fade(QRectF(0, H - fy, W, fy), 0, H, 0, H - fy)
        q.end()

        self._cache[key] = out
        return out

    def _vbar(self, p, x, y, bw, bh, ratio, color, icon, value, k):
        ratio = max(0.0, min(1.0, ratio))
        cx = x + bw / 2

        # ikon di atas bar
        draw_icon(p, icon, QRectF(cx - 11 * k, y - 40 * k, 22 * k, 22 * k), "#cbd5e1")

        # track
        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#14213d"))
        p.drawRoundedRect(QRectF(x, y, bw, bh), bw / 2, bw / 2)

        # isi: glow + gradient terang
        fh = bh * ratio
        if fh > 1:
            glow = QColor(color)
            glow.setAlpha(45)
            p.setBrush(glow)
            gw = bw + 6 * k
            p.drawRoundedRect(QRectF(x - 3 * k, y + bh - fh - 3 * k, gw, fh + 6 * k), gw / 2, gw / 2)

            g = QLinearGradient(0, y + bh, 0, y)
            g.setColorAt(0.0, color.darker(110))
            g.setColorAt(1.0, color.lighter(135))
            p.setBrush(QBrush(g))
            p.drawRoundedRect(QRectF(x, y + bh - fh, bw, fh), bw / 2, bw / 2)

        # nilai di bawah bar
        p.setPen(QColor("#ffffff"))
        p.setFont(font(15 * k, True))
        p.drawText(QRectF(cx - 40 * k, y + bh + 10 * k, 80 * k, 22 * k), Qt.AlignCenter, value)

    def _chip(self, p, rect, title, value, color, k):
        p.setPen(QPen(QColor("#1e293b"), 1))
        p.setBrush(QColor("#0f172a"))
        p.drawRoundedRect(rect, 10 * k, 10 * k)

        p.setPen(Qt.NoPen)
        p.setBrush(QColor(color))
        p.drawRoundedRect(QRectF(rect.x() + 8 * k, rect.y() + 12 * k, 3 * k, rect.height() - 24 * k), 1.5, 1.5)

        p.setPen(QColor(GRAY))
        p.setFont(font(9 * k, True))
        p.drawText(QRectF(rect.x() + 18 * k, rect.y() + 8 * k, rect.width() - 24 * k, 14 * k),
                   Qt.AlignLeft | Qt.AlignVCenter, title)
        p.setPen(QColor("#ffffff"))
        p.setFont(font(17 * k, True))
        p.drawText(QRectF(rect.x() + 18 * k, rect.y() + 24 * k, rect.width() - 24 * k, rect.height() - 28 * k),
                   Qt.AlignLeft | Qt.AlignVCenter, value)

    # ---------------- paint ----------------
    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)

        w, h = float(self.width()), float(self.height())
        k = max(0.9, min(1.6, min(w / 560.0, h / 520.0)))   # faktor skala UI

        if self.current_tab == "Engine":
            self._paint_engine(p, w, h, k)
        elif self.current_tab == "Wheels":
            self._paint_wheels(p, w, h, k)
        else:
            self._paint_car(p, w, h, k)

    # ---------- TAB: WHOLE CAR ----------
    def _paint_car(self, p, w, h, k):
        margin = 8 * k
        area_h = h - margin * 2
        cx = w / 2

        pix = self._car(w * 0.50, area_h * 0.96)
        if pix:
            iw, ih = float(pix.width()), float(pix.height())
        else:
            iw, ih = area_h * 0.45, area_h * 0.9
        ix = cx - iw / 2
        iy = margin + (area_h - ih) / 2

        # glow lembut di belakang mobil
        glow = QRadialGradient(QPointF(cx, iy + ih / 2), max(iw, ih) * 0.75)
        glow.setColorAt(0.0, QColor(56, 189, 248, 42))
        glow.setColorAt(1.0, QColor(56, 189, 248, 0))
        p.setPen(Qt.NoPen)
        p.fillRect(QRectF(0, margin, w, area_h), QBrush(glow))

        if pix:
            p.drawPixmap(int(ix), int(iy), pix)
        else:
            p.setPen(QPen(QColor("#334155"), 2))
            p.setBrush(Qt.NoBrush)
            p.drawRoundedRect(QRectF(ix, iy, iw, ih), 22, 22)

        # bar baterai (kiri) & suhu (kanan), tingginya mengikuti tinggi mobil
        bar_w = 10 * k
        bar_h = min(ih * 0.64, area_h * 0.60)
        bar_y = iy + (ih - bar_h) / 2 - 4 * k
        x_l = max(w * 0.09, cx - iw / 2 - w * 0.14)
        x_r = min(w * 0.91 - bar_w, cx + iw / 2 + w * 0.14 - bar_w)

        soc_col = QColor(RED if self.soc < 20 else (AMBER if self.soc < 40 else CYAN))
        tmp_col = QColor(RED if self.temp >= 45 else (AMBER if self.temp >= 38 else CYAN))

        self._vbar(p, x_l, bar_y, bar_w, bar_h, self.soc / 100.0, soc_col,
                   "battery", f"{self.soc}%", k)
        self._vbar(p, x_r, bar_y, bar_w, bar_h, min(50.0, self.temp) / 50.0, tmp_col,
                   "thermo", f"{int(self.temp)}°C", k)

    # ---------- TAB: ENGINE ----------
    def _paint_engine(self, p, w, h, k):
        margin = 14 * k
        p.setPen(QColor("#ffffff"))
        p.setFont(font(14 * k, True))
        p.drawText(QRectF(0, margin, w, 24 * k), Qt.AlignCenter, "STATUS MOTOR PENGGERAK (DINAMO)")

        rpm = int(self.speed * 42.5)
        motor_temp = min(95, int(35 + self.speed * 0.4))
        pwr_kw = round(self.speed * 0.15, 1)

        metrics = [
            ("PUTARAN MOTOR", f"{rpm} RPM", CYAN),
            ("SUHU MOTOR", f"{motor_temp}°C", GREEN if motor_temp < 80 else RED),
            ("OUTPUT DAYA", f"{pwr_kw} kW", AMBER),
            ("EFISIENSI", "94.2%", GREEN),
        ]

        gap = 12 * k
        top = margin + 40 * k
        card_w = (w - margin * 2 - gap) / 2
        card_h = max(60 * k, min(120 * k, (h - top - margin - 70 * k - gap) / 2))

        for idx, (title, val, col) in enumerate(metrics):
            rx = margin + (idx % 2) * (card_w + gap)
            ry = top + (idx // 2) * (card_h + gap)
            self._chip(p, QRectF(rx, ry, card_w, card_h), title, val, col, k)

        by = top + 2 * card_h + gap + 22 * k
        p.setPen(QColor(GRAY))
        p.setFont(font(10 * k, True))
        p.drawText(QRectF(margin, by - 20 * k, w, 16 * k), Qt.AlignLeft, "BEBAN MOTOR")
        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#1e293b"))
        p.drawRoundedRect(QRectF(margin, by, w - margin * 2, 12 * k), 6 * k, 6 * k)
        ratio = max(0.0, min(1.0, self.speed / MAX_SPEED))
        if ratio > 0.01:
            g = QLinearGradient(margin, 0, w - margin, 0)
            g.setColorAt(0, QColor(CYAN))
            g.setColorAt(0.7, QColor(AMBER))
            g.setColorAt(1, QColor(RED))
            p.setBrush(QBrush(g))
            p.drawRoundedRect(QRectF(margin, by, (w - margin * 2) * ratio, 12 * k), 6 * k, 6 * k)

    # ---------- TAB: WHEELS ----------
    def _paint_wheels(self, p, w, h, k):
        margin = 14 * k
        cx = w / 2
        p.setPen(QColor("#ffffff"))
        p.setFont(font(14 * k, True))
        p.drawText(QRectF(0, margin, w, 24 * k), Qt.AlignCenter, "MONITORING TEKANAN BAN (TPMS)")

        top = margin + 40 * k
        status_h = 36 * k
        avail_h = h - top - status_h - margin

        box_h = min(avail_h, 340 * k)
        box_w = box_h * 0.62
        bx = cx - box_w / 2
        by = top + (avail_h - box_h) / 2

        glow = QRadialGradient(QPointF(cx, by + box_h / 2), box_h * 0.7)
        glow.setColorAt(0.0, QColor(56, 189, 248, 40))
        glow.setColorAt(1.0, QColor(56, 189, 248, 0))
        p.setPen(Qt.NoPen)
        p.fillRect(QRectF(0, top, w, avail_h), QBrush(glow))

        p.setPen(QPen(QColor("#334155"), 2, Qt.DashLine))
        p.setBrush(Qt.NoBrush)
        p.drawRoundedRect(QRectF(bx, by, box_w, box_h), 16 * k, 16 * k)

        pix = self._car(box_w * 0.95, box_h * 0.97)
        if pix:
            p.setOpacity(0.75)
            p.drawPixmap(int(cx - pix.width() / 2), int(by + (box_h - pix.height()) / 2), pix)
            p.setOpacity(1.0)

        bw, bh = 60 * k, 66 * k
        left_x = bx - bw * 0.62
        right_x = bx + box_w - bw * 0.38
        top_y = by + box_h * 0.06
        bot_y = by + box_h * 0.94 - bh
        wheels = [
            (left_x, top_y, "FL", self.tpms[0]),
            (right_x, top_y, "FR", self.tpms[1]),
            (left_x, bot_y, "RL", self.tpms[2]),
            (right_x, bot_y, "RR", self.tpms[3]),
        ]

        all_ok = True
        for wx, wy, label, psi in wheels:
            if 30 <= psi <= 40:
                col, bg = GREEN, "#062016"
            elif 25 <= psi <= 45:
                col, bg, all_ok = AMBER, "#2a1a04", False
            else:
                col, bg, all_ok = RED, "#2a0a0a", False

            p.setPen(QPen(QColor(col), 1.6))
            p.setBrush(QColor(bg))
            p.drawRoundedRect(QRectF(wx, wy, bw, bh), 10 * k, 10 * k)

            p.setPen(QColor("#94a3b8"))
            p.setFont(font(10 * k, True))
            p.drawText(QRectF(wx, wy + 6 * k, bw, 14 * k), Qt.AlignCenter, label)
            p.setPen(QColor(col))
            p.setFont(font(18 * k, True))
            p.drawText(QRectF(wx, wy + 22 * k, bw, 24 * k), Qt.AlignCenter, str(psi))
            p.setPen(QColor(GRAY))
            p.setFont(font(8 * k, True))
            p.drawText(QRectF(wx, wy + 47 * k, bw, 12 * k), Qt.AlignCenter, "PSI")

        p.setPen(QColor(GREEN if all_ok else AMBER))
        p.setFont(font(11 * k, True))
        msg = ("Semua roda dalam tekanan ideal (30-40 PSI)" if all_ok
               else "Periksa ban yang berwarna kuning / merah")
        p.drawText(QRectF(0, h - margin - status_h, w, status_h), Qt.AlignCenter, msg)


class MetricCard(QFrame):
    """Kartu metrik seragam: ikon + judul, angka besar, bar progres, sub-teks."""

    def __init__(self, title, color, icon, unit="%", max_value=100.0, sub_l="", sub_r=""):
        super().__init__()
        self.setObjectName("card")
        self.setStyleSheet(card_style())
        self.unit = unit
        self.max_value = float(max_value)
        self._last = None

        lay = QVBoxLayout(self)
        lay.setContentsMargins(18, 14, 18, 14)
        lay.setSpacing(6)

        head = QHBoxLayout()
        head.setSpacing(8)
        lbl_t = QLabel(title.upper())
        lbl_t.setStyleSheet(f"color: {GRAY}; font-size: 11px; font-weight: bold;")
        head.addWidget(IconWidget(icon, 18, color))
        head.addWidget(lbl_t)
        head.addStretch()

        self.lbl_val = QLabel()
        self.lbl_val.setTextFormat(Qt.RichText)

        self.pbar = QProgressBar()
        self.pbar.setFixedHeight(8)
        self.pbar.setRange(0, 100)
        self.pbar.setTextVisible(False)
        self.pbar.setStyleSheet(f"""
            QProgressBar {{
                border: none;
                border-radius: 4px;
                background-color: #1e293b;
            }}
            QProgressBar::chunk {{
                background-color: {color};
                border-radius: 4px;
            }}
        """)

        sub_row = QHBoxLayout()
        self.lbl_sub_l = QLabel(sub_l)
        self.lbl_sub_l.setStyleSheet(f"color: {GRAY}; font-size: 12px;")
        self.lbl_sub_r = QLabel(sub_r)
        self.lbl_sub_r.setStyleSheet(f"color: {GRAY}; font-size: 12px;")
        sub_row.addWidget(self.lbl_sub_l)
        sub_row.addStretch()
        sub_row.addWidget(self.lbl_sub_r)

        lay.addLayout(head)
        lay.addStretch(1)
        lay.addWidget(self.lbl_val)
        lay.addWidget(self.pbar)
        lay.addLayout(sub_row)
        self.update_data(0, sub_l, sub_r)

    def update_data(self, val, sub_l="", sub_r=""):
        key = (val, sub_l, sub_r)
        if key == self._last:
            return
        self._last = key
        sep = "" if self.unit == "%" else " "
        self.lbl_val.setText(
            f'<span style="font-size:34px; font-weight:bold; color:#ffffff;">{val}</span>'
            f'<span style="font-size:16px; font-weight:bold; color:#94a3b8;">{sep}{self.unit}</span>')
        self.pbar.setValue(int(max(0.0, min(100.0, val / self.max_value * 100.0))))
        self.lbl_sub_l.setText(sub_l)
        self.lbl_sub_r.setText(sub_r)


