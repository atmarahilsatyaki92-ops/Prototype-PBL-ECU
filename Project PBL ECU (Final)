class EVDashboardMain(QMainWindow):
    def __init__(self, port=None):
        super().__init__()
        self.setWindowTitle("Smart E-Vehicle Monitoring System - Polibatam")
        self.setStyleSheet(
            "QMainWindow { background-color: #070b14; }"
            "QLabel { background: transparent; color: #f8fafc; }"
        )
        screen = QApplication.primaryScreen().availableGeometry()
        self.resize(min(1360, screen.width() - 40), min(860, screen.height() - 60))

        self.ser = None
        self.port_name = None
        self.init_serial(port)
        self.demo = self.ser is None

        self.raw = dict(DEFAULT_RAW)
        self.sim = Simulator()

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.page_auth = AuthPage(self.on_login_success)
        self.page_dash = DashboardPage(self.on_logout, self.on_drive_mode_change)

        self.stack.addWidget(self.page_auth)
        self.stack.addWidget(self.page_dash)

        self.stack.setCurrentWidget(self.page_auth)

        self.timer = QTimer()
        self.timer.setInterval(UPDATE_MS)
        self.timer.timeout.connect(self.update_telemetry)
        self.timer.start()

        self.clock_timer = QTimer()
        self.clock_timer.setInterval(1000)
        self.clock_timer.timeout.connect(self.update_clock)
        self.clock_timer.start()
        self.update_clock()

    def init_serial(self, port=None):
        if serial is None:
            return
        if port is None:
            for p in list_ports.comports():
                text = f"{p.description} {p.manufacturer or ''}"
                if any(k in text for k in ["STM", "CH340", "CP210"]):
                    port = p.device
                    break
        if port is None:
            return
        try:
            self.ser = serial.Serial(port, BAUDRATE, timeout=0.05)
            self.port_name = port
        except Exception:
            pass

    def read_serial(self):
        packet = None
        try:
            while self.ser and self.ser.in_waiting:
                line = self.ser.readline().decode("utf-8", errors="ignore").strip()
                if line:
                    obj = json.loads(line)
                    if isinstance(obj, dict):
                        packet = obj
        except Exception:
            self.ser = None
        return packet

    def on_login_success(self, user_info):
        self.page_dash.lbl_user.setText(user_info)
        self.stack.setCurrentWidget(self.page_dash)

    def on_logout(self):
        self.stack.setCurrentWidget(self.page_auth)

    def on_drive_mode_change(self, mode_key):
        self.raw["drive_mode"] = mode_key
        self.sim.drive_mode = mode_key

    def update_clock(self):
        now = datetime.datetime.now()
        time_str = now.strftime("%H:%M")
        time_12h = now.strftime("%I:%M %p").lstrip('0')
        self.page_dash.lbl_time.setText(time_str)
        self.page_dash.set_big_clock(time_12h)

    def update_telemetry(self):
        if self.demo:
            self.raw.update(self.sim.step())
        elif self.ser:
            packet = self.read_serial()
            if packet:
                self.raw.update(packet)

        if self.stack.currentWidget() == self.page_dash:
            self.page_dash.render(build_view(self.raw))


if __name__ == "__main__":
    port_arg = sys.argv[1] if len(sys.argv) > 1 else None
    QApplication.setAttribute(Qt.AA_EnableHighDpiScaling, True)
    app = QApplication(sys.argv)
    window = EVDashboardMain(port_arg)
    window.show()
    sys.exit(app.exec_())