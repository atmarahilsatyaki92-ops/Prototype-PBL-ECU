def draw_icon(p, name, rect, color, lw=1.8):
    """Gambar ikon outline pada kotak 'rect'. Koordinat internal 24x24."""
    p.save()
    p.setRenderHint(QPainter.Antialiasing)
    p.translate(rect.x(), rect.y())
    p.scale(rect.width() / 24.0, rect.height() / 24.0)
    p.setPen(QPen(QColor(color), lw, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
    p.setBrush(Qt.NoBrush)

    if name == "battery":
        p.drawRoundedRect(QRectF(7, 5, 10, 16), 2, 2)
        p.drawLine(QPointF(10, 3), QPointF(14, 3))
        for yy in (10, 13.5, 17):
            p.drawLine(QPointF(10, yy), QPointF(14, yy))

    elif name == "thermo":
        stem = QPainterPath()
        stem.addRoundedRect(QRectF(9.5, 2.5, 5, 13), 2.5, 2.5)
        bulb = QPainterPath()
        bulb.addEllipse(QPointF(12, 17.5), 4, 4)
        p.drawPath(stem.united(bulb))
        p.drawLine(QPointF(12, 8), QPointF(12, 17))
        p.setBrush(QColor(color))
        p.drawEllipse(QPointF(12, 17.5), 1.8, 1.8)
        p.setBrush(Qt.NoBrush)
        for yy in (6, 9.5, 13):
            p.drawLine(QPointF(17.5, yy), QPointF(20, yy))

    elif name == "speaker":
        path = QPainterPath()
        path.moveTo(4, 9.5)
        path.lineTo(8, 9.5)
        path.lineTo(12.5, 5.5)
        path.lineTo(12.5, 18.5)
        path.lineTo(8, 14.5)
        path.lineTo(4, 14.5)
        path.closeSubpath()
        p.drawPath(path)
        p.drawArc(QRectF(10, 8, 7, 8), -45 * 16, 90 * 16)
        p.drawArc(QRectF(8, 5, 12, 14), -45 * 16, 90 * 16)

    elif name == "headset":
        p.drawArc(QRectF(4, 3.5, 16, 16), 0, 180 * 16)
        p.drawRoundedRect(QRectF(3, 12, 4, 6.5), 1.5, 1.5)
        p.drawRoundedRect(QRectF(17, 12, 4, 6.5), 1.5, 1.5)
        mic = QPainterPath()
        mic.moveTo(19, 18.5)
        mic.quadTo(19, 21.5, 13.5, 21.5)
        p.drawPath(mic)

    elif name == "phone":
        path = QPainterPath()
        path.moveTo(6.5, 3.5)
        path.lineTo(9.5, 3.5)
        path.lineTo(11, 7.5)
        path.lineTo(9, 9)
        path.cubicTo(10, 11.5, 12.5, 14, 15, 15)
        path.lineTo(16.5, 13)
        path.lineTo(20.5, 14.5)
        path.lineTo(20.5, 17.5)
        path.cubicTo(20.5, 19, 19.5, 20.5, 18, 20.5)
        path.cubicTo(10, 20.5, 3.5, 14, 3.5, 6)
        path.cubicTo(3.5, 4.5, 5, 3.5, 6.5, 3.5)
        path.closeSubpath()
        p.drawPath(path)

    elif name == "seat":
        p.drawRoundedRect(QRectF(5.5, 3, 7.5, 11.5), 3, 3)
        p.drawRoundedRect(QRectF(5.5, 14.5, 13, 5), 2, 2)
        for xw in (16.5, 20):
            w = QPainterPath()
            w.moveTo(xw, 3.5)
            w.cubicTo(xw + 2, 5.5, xw - 2, 7.5, xw, 9.5)
            p.drawPath(w)

    elif name == "wheel":
        p.drawEllipse(QPointF(12, 12), 9, 9)
        p.drawEllipse(QPointF(12, 12), 2.2, 2.2)
        p.drawLine(QPointF(3.2, 11), QPointF(9.8, 12))
        p.drawLine(QPointF(14.2, 12), QPointF(20.8, 11))
        p.drawLine(QPointF(12, 14.2), QPointF(12, 21))

    elif name == "defrost":
        path = QPainterPath()
        path.moveTo(3, 20)
        path.lineTo(6, 11)
        path.quadTo(12, 8.5, 18, 11)
        path.lineTo(21, 20)
        path.closeSubpath()
        p.drawPath(path)
        for xw in (9, 12, 15):
            w = QPainterPath()
            w.moveTo(xw, 18)
            w.cubicTo(xw - 1.6, 16.5, xw + 1.6, 15, xw, 13.5)
            p.drawPath(w)

    elif name == "fan":
        p.translate(12, 12)
        for i in range(3):
            p.save()
            p.rotate(i * 120)
            p.drawEllipse(QPointF(0, -5.4), 2.9, 5.0)
            p.restore()
        p.drawEllipse(QPointF(0, 0), 1.3, 1.3)

    elif name == "bolt":
        path = QPainterPath()
        path.moveTo(13.5, 2.5)
        path.lineTo(5.5, 13.5)
        path.lineTo(11.5, 13.5)
        path.lineTo(10.5, 21.5)
        path.lineTo(18.5, 10.5)
        path.lineTo(12.5, 10.5)
        path.closeSubpath()
        p.drawPath(path)

    elif name == "shield":
        path = QPainterPath()
        path.moveTo(12, 3)
        path.lineTo(20, 6)
        path.lineTo(20, 12)
        path.cubicTo(20, 17, 16, 20, 12, 21.5)
        path.cubicTo(8, 20, 4, 17, 4, 12)
        path.lineTo(4, 6)
        path.closeSubpath()
        p.drawPath(path)
        chk = QPainterPath()
        chk.moveTo(8.5, 12)
        chk.lineTo(11, 14.5)
        chk.lineTo(15.5, 9.5)
        p.drawPath(chk)

    elif name == "lock":
        p.drawRoundedRect(QRectF(5.5, 10.5, 13, 10), 2, 2)
        p.drawArc(QRectF(8, 3.5, 8, 9), 0, 180 * 16)
        p.drawLine(QPointF(12, 14.5), QPointF(12, 17))

    elif name == "pin":
        path = QPainterPath()
        path.moveTo(12, 21)
        path.cubicTo(12, 21, 5.5, 14.5, 5.5, 9.5)
        path.cubicTo(5.5, 5.5, 8.5, 3, 12, 3)
        path.cubicTo(15.5, 3, 18.5, 5.5, 18.5, 9.5)
        path.cubicTo(18.5, 14.5, 12, 21, 12, 21)
        path.closeSubpath()
        p.drawPath(path)
        p.drawEllipse(QPointF(12, 9.5), 2.5, 2.5)

    elif name == "tire":
        p.drawEllipse(QPointF(12, 12), 9, 9)
        p.drawEllipse(QPointF(12, 12), 4, 4)
        for i in range(5):
            a = math.radians(i * 72 - 90)
            p.drawLine(QPointF(12 + 4 * math.cos(a), 12 + 4 * math.sin(a)),
                       QPointF(12 + 9 * math.cos(a), 12 + 9 * math.sin(a)))

    elif name == "fuel":
        p.drawRoundedRect(QRectF(5, 4, 9, 17), 1.5, 1.5)
        p.drawLine(QPointF(7.5, 9), QPointF(11.5, 9))
        hose = QPainterPath()
        hose.moveTo(14, 8)
        hose.lineTo(17.5, 8)
        hose.lineTo(19.5, 10.5)
        hose.lineTo(19.5, 17)
        p.drawPath(hose)
        p.drawLine(QPointF(4, 21), QPointF(15, 21))

    elif name == "hybrid":
        p.drawLine(QPointF(4, 8.5), QPointF(20, 8.5))
        a1 = QPainterPath()
        a1.moveTo(16.5, 5)
        a1.lineTo(20, 8.5)
        a1.lineTo(16.5, 12)
        p.drawPath(a1)
        p.drawLine(QPointF(20, 15.5), QPointF(4, 15.5))
        a2 = QPainterPath()
        a2.moveTo(7.5, 12)
        a2.lineTo(4, 15.5)
        a2.lineTo(7.5, 19)
        p.drawPath(a2)

    elif name == "gauge":
        p.drawArc(QRectF(3, 4, 18, 18), -20 * 16, 220 * 16)
        p.drawLine(QPointF(12, 13), QPointF(16.5, 8.5))
        p.setBrush(QColor(color))
        p.drawEllipse(QPointF(12, 13), 1.4, 1.4)
        p.setBrush(Qt.NoBrush)

    elif name == "chart":
        ax = QPainterPath()
        ax.moveTo(4, 4)
        ax.lineTo(4, 20)
        ax.lineTo(20, 20)
        p.drawPath(ax)
        ln = QPainterPath()
        ln.moveTo(7.5, 15.5)
        ln.lineTo(11, 11)
        ln.lineTo(14, 13.5)
        ln.lineTo(19, 7.5)
        p.drawPath(ln)

    p.restore()


class IconWidget(QWidget):
    def __init__(self, name, size=20, color="#94a3b8", parent=None):
        super().__init__(parent)
        self.name = name
        self.color = color
        self.setFixedSize(S(size), S(size))

    def set_color(self, color):
        if color != self.color:
            self.color = color
            self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        draw_icon(p, self.name, QRectF(self.rect()), self.color)


def make_card_head(icon, title, icon_color="#94a3b8", with_value=False):
    """Baris judul kartu seragam: ikon + judul (+ nilai di kanan). Return (layout, label_nilai|None)."""
    row = QHBoxLayout()
    row.setSpacing(S(8))
    row.addWidget(IconWidget(icon, 16, icon_color))
    lbl = QLabel(title.upper())
    lbl.setStyleSheet(label_qss(GRAY, 11, True))
    row.addWidget(lbl)
    row.addStretch()
    val = None
    if with_value:
        val = QLabel("--")
        val.setStyleSheet(label_qss(CYAN, 13, True))
        row.addWidget(val)
    return row, val


class RoundIconButton(QPushButton):
    """Tombol bulat dengan ikon vektor. kind: dark | logout | auto."""

    def __init__(self, icon, diameter=40, kind="dark", checkable=False, parent=None):
        super().__init__(parent)
        self.icon_name = icon
        self.kind = kind
        self.active = True          # dipakai oleh kind="auto"
        self.setFixedSize(S(diameter), S(diameter))
        self.setCursor(Qt.PointingHandCursor)
        self.setCheckable(checkable)
        self.setFocusPolicy(Qt.NoFocus)
        self.setAttribute(Qt.WA_Hover, True)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(1.5, 1.5, -1.5, -1.5)
        hover = self.underMouse()

        if self.kind == "auto":
            inner = r.adjusted(3, 3, -3, -3)
            if self.active:
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(56, 189, 248, 45))
                p.drawEllipse(QRectF(self.rect()))
                g = QLinearGradient(inner.topLeft(), inner.bottomRight())
                g.setColorAt(0.0, QColor("#38bdf8"))
                g.setColorAt(1.0, QColor("#0284c7"))
                p.setBrush(QBrush(g))
                p.drawEllipse(inner)
                fg = "#ffffff"
            else:
                p.setPen(QPen(QColor("#334155"), 1.2))
                p.setBrush(QColor("#1e293b"))
                p.drawEllipse(inner)
                fg = "#64748b"
            ds = inner.width() * 0.56
            draw_icon(p, self.icon_name,
                      QRectF(inner.center().x() - ds / 2, inner.center().y() - ds / 2, ds, ds), fg, 1.7)
            return

        if self.kind == "logout":
            bg = "#dc2626" if hover else "#991b1b"
            border, fg = "#b91c1c", "#ffffff"
        elif self.isChecked():
            bg, border, fg = "#0c4a6e", "#0284c7", "#38bdf8"
        else:
