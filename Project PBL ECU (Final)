class DashboardPage(QWidget):
    def __init__(self, on_logout, on_drive_mode_change):
        super().__init__()
        self.on_logout = on_logout
        self.on_drive_mode_change = on_drive_mode_change
        self.volume = 45
        self.ac_temp = 20
        self.is_auto_ac = True
        self._chip_state = {}
        self._conn_key = None
        self._amb_key = None
        self.init_ui()

    def make_card(self):
        card = QFrame()
        card.setObjectName("card")
        card.setStyleSheet(card_style())
        return card

    def set_big_clock(self, text):
        """Jam: angka tebal + AM/PM kecil."""
        parts = text.split(" ")
        if len(parts) == 2:
            html = (f'<span style="font-size:{S(30)}px; font-weight:600; color:#ffffff;">{parts[0]}</span>'
                    f'&nbsp;<span style="font-size:{S(13)}px; font-weight:600; color:#94a3b8;">{parts[1]}</span>')
        else:
            html = f'<span style="font-size:{S(30)}px; font-weight:600; color:#ffffff;">{text}</span>'
        self.lbl_big_clock.setText(html)

    def set_ambient(self, temp):
        """Suhu lingkungan (ambient temperature sensor) di sisi kanan jam."""
        t = int(round(temp))
        if t == self._amb_key:
            return
        self._amb_key = t
        self.lbl_ambient.setText(
            f'<div align="right"><span style="font-size:{S(19)}px; font-weight:bold; color:#ffffff;">{t}°C</span><br>'
            f'<span style="font-size:{S(11)}px; font-weight:bold; color:#94a3b8;">SUHU LUAR</span></div>')

    def set_connection(self, text, color):
        """Indikator sumber data di header (DEMO / COM port / TERPUTUS)."""
        key = (text, color)
        if key == self._conn_key:
            return
        self._conn_key = key
        c = QColor(color)
        self.lbl_conn.setText(f"● {text}")
        self.lbl_conn.setStyleSheet(
            f"color: {color}; font-size: {S(11)}px; font-weight: bold; "
            f"background: rgba({c.red()}, {c.green()}, {c.blue()}, 0.14); "
            f"padding: {S(5)}px {S(12)}px; border-radius: {S(7)}px;")

    def _make_chip(self):
        lbl = QLabel("● NORMAL")
        lbl.setAlignment(Qt.AlignCenter)
        self._set_chip(lbl, "NORMAL", GREEN)
        return lbl

    def _set_chip(self, lbl, text, color):
        if self._chip_state.get(id(lbl)) == (text, color):
            return
        self._chip_state[id(lbl)] = (text, color)
        c = QColor(color)
        lbl.setText(f"● {text}")
        lbl.setStyleSheet(f"color: {color}; font-size: {S(11)}px; font-weight: bold; "
                          f"background: rgba({c.red()}, {c.green()}, {c.blue()}, 0.15); "
                          f"padding: {S(3)}px {S(8)}px; border-radius: {S(4)}px;")

    def _gauge_cell(self, title, meter):
        """Satu sel gauge: judul + chip status di atas, busur di bawah."""
        cell = QVBoxLayout()
        cell.setSpacing(S(2))
        top = QHBoxLayout()
        lbl = QLabel(title)
        lbl.setStyleSheet(label_qss("#ffffff", 14, True))
        chip = self._make_chip()
        top.addWidget(lbl)
        top.addStretch()
        top.addWidget(chip)
        cell.addLayout(top)
        cell.addWidget(meter, 1)
        return cell, chip

