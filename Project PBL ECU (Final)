def S(v):
    """Skalakan ukuran piksel dengan faktor skala global."""
    return int(round(v * UI["scale"]))


def font(px, bold=False):
    """Font dengan ukuran desain (otomatis diskalakan)."""
    f = QFont("Segoe UI")
    f.setPixelSize(max(8, S(px)))
    f.setBold(bold)
    return f


def rfont(px, bold=False):
    """Font dengan ukuran piksel mentah (untuk ukuran yang sudah diturunkan dari geometri widget)."""
    f = QFont("Segoe UI")
    f.setPixelSize(max(8, int(px)))
    f.setBold(bold)
    return f


def text_width(f, text):
    fm = QFontMetrics(f)
    if hasattr(fm, "horizontalAdvance"):
        return fm.horizontalAdvance(text)
    return fm.width(text)


