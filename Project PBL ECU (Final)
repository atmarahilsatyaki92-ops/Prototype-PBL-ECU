class Simulator:
    """
    Simulator kendaraan dengan model energi sederhana:
      - baterai terkuras oleh arus (EV paling boros, HEV sedang, ICE hampir nol)
      - saat pengereman (DECEL) di EV/HEV terjadi regen -> baterai terisi
      - saat ICE dan SOC < 20% generator mengisi baterai
      - bensin terpakai menurut jarak tempuh (ICE penuh, HEV separuh, EV nol)
      - AFR ~14.7 saat mesin hidup (campuran kaya saat akselerasi); None saat mesin mati
    Waktu dipercepat DEMO_SPEEDUP kali supaya perubahan terlihat dalam hitungan menit.
    Status uji (pintu, sabuk, ban, AFR) bisa diubah lewat tombol keyboard di mode demo.
    """

    TIRE_STATES = [[33, 33, 37, 37], [33, 33, 28, 37], [33, 33, 22, 37]]
    AFR_OVERRIDES = [None, 12.8, 16.2, 18.0]      # auto, kaya, miskin, sangat miskin

    def __init__(self):
        self.speed = 61.0
        self.target = 61.0
        self.ambient = 31.0
        self.bat_temp = 32.0
        self.fuel = 77.0
        self.soc = 69.0
        self.tick = 0
        self.drive_mode = "ICE"
        self.gear = "D"
        self.idle_counter = 0
        # status uji
        self.doors = [False, False, False, False]
        self.belt = True
        self.tire_state = 0
        self.afr_state = 0
        self.turn_left = False
        self.turn_right = False
        self.hazard = False

    def toggle_signal(self, which):
        if which == "left":
            self.turn_left = not self.turn_left
            if self.turn_left:
                self.turn_right = False        # sein kiri & kanan tidak bisa aktif bersamaan
        elif which == "right":
            self.turn_right = not self.turn_right
            if self.turn_right:
                self.turn_left = False
        elif which == "hazard":
            self.hazard = not self.hazard

    def cycle_tire_fault(self):
        self.tire_state = (self.tire_state + 1) % len(self.TIRE_STATES)

    def cycle_afr_override(self):
        self.afr_state = (self.afr_state + 1) % len(self.AFR_OVERRIDES)

    def step(self):
        self.tick += 1
        if self.tick % 60 == 1:
            self.target = random.choice([0.0, 30.0, 61.0, 85.0, 0.0])

        accel_val = (self.target - self.speed) * 0.05
        accel_val = max(-1.5, min(0.8, accel_val))
        accel_state = "ACCEL" if accel_val > 0.1 else ("DECEL" if accel_val < -0.1 else "HOLD")

        self.speed = max(0.0, self.speed + accel_val)

        if self.speed > 1.0:
            self.gear = "D"
            self.idle_counter = 0
        elif self.speed <= 1.0:
            self.idle_counter += 1
            if self.idle_counter < 15:
                self.gear = "N"
            else:
                self.gear = "P"

        # --- arus (A): positif = baterai menyuplai, negatif = baterai terisi ---
        mode = self.drive_mode
        if mode == "EV":
            k, boost = 0.9, 12.0
        elif mode == "HYBRID":
            k, boost = 0.35, 5.0
        else:
            k, boost = 0.045, 0.0
        current = self.speed * k + (boost if accel_state == "ACCEL" else 0.0) + random.uniform(-0.5, 0.5)
        if self.speed <= 1.0:
            current = 0.2 + random.uniform(0.0, 0.2)                       # beban aksesori saat diam
        elif mode in ("EV", "HYBRID") and accel_state == "DECEL" and self.speed > 3.0:
            current = -min(25.0, self.speed * 0.3)                         # regenerative braking
        elif mode == "ICE" and self.soc < 20.0:
            current = -6.0                                                 # generator mengisi baterai
        if self.soc <= 0.5 and current > 0:
            current = 0.0                                                  # baterai habis
        current = max(-60.0, min(120.0, current))

        # --- integrasi energi baterai (waktu dipercepat) ---
        dt_h = (UPDATE_MS / 1000.0) * DEMO_SPEEDUP / 3600.0
        d_ah = current * dt_h * (0.7 if current < 0 else 1.0)              # efisiensi pengisian 70%
        self.soc = max(0.0, min(100.0, self.soc - d_ah / BATTERY_AH * 100.0))

        # --- bensin: pemakaian mengikuti jarak tempuh ---
        dist_km = self.speed * dt_h
        share = 1.0 if mode == "ICE" else (0.5 if mode == "HYBRID" else 0.0)
        used_l = dist_km * share / FUEL_KM_PER_L
        self.fuel = max(3.0, self.fuel - used_l / FUEL_CAPACITY_LITERS * 100.0)

        # --- tegangan mengikuti SOC (+ sedikit sag saat beban) & suhu baterai mengikuti arus ---
        voltage = 60.0 + 24.0 * self.soc / 100.0 - 0.01 * max(current, 0.0) + random.uniform(-0.02, 0.02)
        self.bat_temp += (30.0 + abs(current) * 0.08 - self.bat_temp) * 0.01

        # --- suhu lingkungan: melayang pelan di sekitar 31 C ---
        self.ambient = max(29.0, min(34.0, self.ambient + random.uniform(-0.01, 0.01)))

        # --- sensor oksigen (AFR): hanya saat mesin bensin hidup ---
        engine_on = mode == "ICE" or (mode == "HYBRID" and (self.speed > 40.0 or accel_state == "ACCEL"))
        if engine_on:
            override = self.AFR_OVERRIDES[self.afr_state]
            if override is not None:
                afr = override + random.uniform(-0.08, 0.08)
            else:
                afr = STOICH_AFR + 0.25 * math.sin(self.tick * 0.45) + random.uniform(-0.08, 0.08)
                if accel_state == "ACCEL":
                    afr -= 1.3                                             # pengayaan campuran saat akselerasi
            afr = round(afr, 2)
        else:
            afr = None

        return {
            "speed": round(self.speed, 1), "voltage": round(voltage, 2),
            "current": round(current, 1), "ambient_temp": round(self.ambient, 1),
            "bat_temp": round(self.bat_temp, 1), "soh": 94,
            "soc": round(self.soc, 2),
            "fuel_level": round(self.fuel, 3),
            "tpms": list(self.TIRE_STATES[self.tire_state]), "tpms_temp": [28, 28, 28, 28],
            "doors": list(self.doors), "door": any(self.doors), "belt": self.belt,
            "afr": afr,
            "turn_left": self.turn_left, "turn_right": self.turn_right, "hazard": self.hazard,
            "drive_mode": self.drive_mode,
            "accel_state": accel_state, "gear": self.gear
        }


