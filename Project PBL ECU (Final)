DOOR_NAMES = ["Depan Kiri", "Depan Kanan", "Belakang Kiri", "Belakang Kanan"]


def classify_afr(afr):
    """Return (status, warna) untuk nilai AFR."""
    for lo, hi, name, col in AFR_BANDS:
        if lo <= afr < hi:
            return name, col
    return "--", GRAY


def get_doors(d):
    """Return [FL, FR, RL, RR] (True = terbuka). Mendukung paket lama dengan satu flag 'door'."""
    doors = d.get("doors")
    if isinstance(doors, (list, tuple)) and len(doors) >= 4:
        return [bool(x) for x in doors[:4]]
    return [False, False, False, False]


