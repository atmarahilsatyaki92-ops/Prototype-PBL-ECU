def rounded_path(x, y, w, h, tl, tr, br, bl):
    """Rounded rectangle dengan radius berbeda per sudut."""
    path = QPainterPath()
    path.moveTo(x + tl, y)
    path.lineTo(x + w - tr, y)
    path.arcTo(x + w - 2 * tr, y, 2 * tr, 2 * tr, 90, -90)
    path.lineTo(x + w, y + h - br)
    path.arcTo(x + w - 2 * br, y + h - 2 * br, 2 * br, 2 * br, 0, -90)
    path.lineTo(x + bl, y + h)
    path.arcTo(x, y + h - 2 * bl, 2 * bl, 2 * bl, 270, -90)
    path.lineTo(x, y + tl)
    path.arcTo(x, y, 2 * tl, 2 * tl, 180, -90)
    path.closeSubpath()
    return path


class IconWidget(QWidget):
    def __init__(self, name, size=20, color="#94a3b8", parent=None):
        super().__init__(parent)
        self.name = name
        self.color = color
        self.setFixedSize(size, size)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        draw_icon(p, self.name, QRectF(self.rect()), self.color)


class RoundIconButton(QPushButton):
    """Tombol bulat dengan ikon vektor. kind: dark | danger | logout | auto."""

    def __init__(self, icon, diameter=44, kind="dark", checkable=False, parent=None):
        super().__init__(parent)
        self.icon_name = icon
        self.kind = kind
        self.active = True          # dipakai oleh kind="auto"
        self.setFixedSize(diameter, diameter)
        self.setCursor(Qt.PointingHandCursor)
        self.setCheckable(checkable)
        self.setFocusPolicy(Qt.NoFocus)
        self.setAttribute(Qt.WA_Hover, True)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(1.5, 1.5, -1.5, -1.5)
        hover = self.underMouse()

        if self.kind == "auto":
            inner = r.adjusted(4, 4, -4, -4)
            if self.active:
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(236, 72, 153, 45))
                p.drawEllipse(QRectF(self.rect()))
                g = QLinearGradient(inner.topLeft(), inner.bottomRight())
                g.setColorAt(0.0, QColor("#f472b6"))
                g.setColorAt(1.0, QColor("#db2777"))
                p.setBrush(QBrush(g))
                p.drawEllipse(inner)
                fg = "#ffffff"
            else:
                p.setPen(QPen(QColor("#334155"), 1.2))
                p.setBrush(QColor("#1e293b"))
                p.drawEllipse(inner)
                fg = "#64748b"
            ds = inner.width() * 0.56
            draw_icon(p, self.icon_name,
