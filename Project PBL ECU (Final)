    def switch_center_tab(self, tab_name):
        self.center_car.set_tab(tab_name)
        active_style = ("color: #ffffff; font-size: 15px; font-weight: bold; border: none; "
                        "border-bottom: 2px solid #ffffff; padding: 4px 6px; background: transparent;")
        inactive_style = ("color: #64748b; font-size: 13px; border: none; "
                          "padding: 4px 6px; background: transparent;")

        self.btn_tab_eng.setStyleSheet(active_style if tab_name == "Engine" else inactive_style)
        self.btn_tab_car.setStyleSheet(active_style if tab_name == "Whole Car" else inactive_style)
        self.btn_tab_whl.setStyleSheet(active_style if tab_name == "Wheels" else inactive_style)

    def toggle_volume(self):
        self.volume = 0 if self.volume >= 100 else self.volume + 15
        self.btn_vol.setText(f"{self.volume}%")

    def toggle_temp(self):
        self.ac_temp = 18 if self.ac_temp >= 26 else self.ac_temp + 1
        self.btn_temp.setText(f"{self.ac_temp}°C")

    def toggle_auto_ac(self):
        self.is_auto_ac = not self.is_auto_ac
        self.update_auto_ac_style()

    def update_auto_ac_style(self):
        self.btn_auto.active = self.is_auto_ac
        self.btn_auto.update()
        self.dock.auto_on = self.is_auto_ac
        self.dock.update()

    def _set_mode_buttons(self, mode_key):
        self.btn_ev.setChecked(mode_key == "EV")
        self.btn_hybrid.setChecked(mode_key == "HYBRID")
        self.btn_ice.setChecked(mode_key == "ICE")

    def change_drive_mode(self, mode_key):
        self._set_mode_buttons(mode_key)
        self.on_drive_mode_change(mode_key)

    def update_mode_pill(self, mode_key):
        txt, col, desc, bg_color, border_color = DRIVE_MODES.get(mode_key, DRIVE_MODES["ICE"])
        self.pill_mode.set_state(f"MODE PENGGERAK: {txt}", f"({desc})", (bg_color, col, border_color))

    def update_status_pills(self, d, drive_mode):
        # --- ban (TPMS) ---
        tpms = d.get("tpms", [33, 33, 37, 37])
        names = ["FL", "FR", "RL", "RR"]
        bad = [(n, v) for n, v in zip(names, tpms) if not (30 <= v <= 40)]
        if not bad:
            self.pill_tire.set_state(f"SEMUA BAN NORMAL ({min(tpms)}-{max(tpms)} PSI)", "", OK_SCHEME)
        else:
            critical = any(v < 25 or v > 45 for _, v in bad)
            txt = "PERIKSA BAN: " + ", ".join(f"{n} {v} PSI" for n, v in bad)
            self.pill_tire.set_state(txt, "", BAD_SCHEME if critical else WARN_SCHEME)

        # --- baterai ---
        em_key = d.get("energy_mode", "REGENERATIVE_READY")
        if drive_mode == "ICE":
            em_txt, em_col, _ = MODE_ENERGY_ICE.get(em_key, MODE_ENERGY_ICE["REGENERATIVE_READY"])
        else:
            em_txt, em_col, _ = MODE_ENERGY_EV.get(em_key, MODE_ENERGY_EV["IDLE"])
        self.pill_bat.set_state(f"KONDISI BATERAI: {em_txt}", "", COLOR_TO_SCHEME.get(em_col, OK_SCHEME))

        # --- keamanan (pintu & sabuk) ---
        door = bool(d.get("door", False))
        belt = bool(d.get("belt", True))
        if door and not belt:
            self.pill_sec.set_state("PERHATIAN: PINTU & SABUK", "pintu terbuka, sabuk belum dipasang", BAD_SCHEME)
        elif door:
            self.pill_sec.set_state("PINTU TERBUKA", "tutup pintu sebelum berkendara", BAD_SCHEME)
        elif not belt:
            self.pill_sec.set_state("SABUK BELUM DIPASANG", "pasang sabuk pengaman", WARN_SCHEME)
        else:
            self.pill_sec.set_state("SISTEM KEAMANAN AMAN", "pintu & sabuk aman", OK_SCHEME)

        self.update_mode_pill(drive_mode)

    def render(self, d):
        speed = float(d["speed"])
        volt = float(d["voltage"])
        cur = float(d["current"])
        soc = int(d["soc"])
        temp = float(d["temp"])
        fuel = float(d.get("fuel", 77.0))
        drive_mode = d.get("drive_mode", "ICE")
        tpms = d.get("tpms", [33, 33, 37, 37])
        gear = d.get("gear", "D")
        soh = int(d.get("soh", 94))
        est_range = int(d.get("est_range", 120))

        self.gauge.set_value(speed)

        self.meter_voltage.set_value(volt)
        self.meter_current.set_value(cur)

        # status chip arus & tegangan (dinamis)
        if cur >= 100:
            self._set_chip(self.chip_i, "TINGGI", RED)
        elif cur >= 80:
            self._set_chip(self.chip_i, "WASPADA", AMBER)
        else:
            self._set_chip(self.chip_i, "NORMAL", GREEN)

        if volt < 62:
            self._set_chip(self.chip_v, "RENDAH", RED)
        elif volt < 66:
            self._set_chip(self.chip_v, "WASPADA", AMBER)
        elif volt > 84:
            self._set_chip(self.chip_v, "TINGGI", RED)
        else:
            self._set_chip(self.chip_v, "NORMAL", GREEN)

        fuel_liters = round((fuel / 100.0) * FUEL_CAPACITY_LITERS, 1)
        self.card_fuel_tank.update_data(int(fuel), "Tangki Bensin", f"{fuel_liters} L / {FUEL_CAPACITY_LITERS} L")

        soh_state = "Kondisi baik" if soh >= 80 else ("Perlu dipantau" if soh >= 60 else "Perlu servis")
        self.card_soh.update_data(soh, "State of Health", soh_state)
        self.card_range.update_data(est_range, "Estimasi sisa jarak", f"SOC {soc}%")

        self.center_car.set_data(tpms, soc, temp, speed)

        self.card_prnd.chart.add_value(int(10 + (speed / 180.0) * 30 + random.randint(-4, 4)))
        self.card_prnd.set_gear(gear)

        self.update_status_pills(d, drive_mode)
        self._set_mode_buttons(drive_mode)


