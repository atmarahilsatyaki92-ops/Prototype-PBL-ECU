class StatusBar(QWidget):
    """Status bar bersegmen (satu baris): netral saat normal, hanya segmen bermasalah yang berwarna."""

    def __init__(self, icons, parent=None):
        super().__init__(parent)
        self.slots = [{"icon": ic, "title": "", "sub": "", "scheme": NEUTRAL_SCHEME,
                       "icon_color": GREEN, "key": None} for ic in icons]
        self.setFixedHeight(S(40))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

    def set_slot(self, idx, title, sub, scheme, icon_color=None):
        slot = self.slots[idx]
        key = (title, sub, scheme, icon_color)
        if slot["key"] == key:
            return
        slot.update(key=key, title=title, sub=sub, scheme=scheme, icon_color=icon_color or scheme[1])
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.TextAntialiasing)
        w, h = float(self.width()), float(self.height())
        n = len(self.slots)
        seg = w / n

        outline = QPainterPath()
        outline.addRoundedRect(QRectF(0.5, 0.5, w - 1, h - 1), h / 2, h / 2)

        # latar + segmen bermasalah diberi warna
        p.save()
        p.setClipPath(outline)
        p.fillRect(QRectF(0, 0, w, h), QColor(NEUTRAL_SCHEME[0]))
        for i, sl in enumerate(self.slots):
            if sl["scheme"] != NEUTRAL_SCHEME:
                p.fillRect(QRectF(i * seg, 0, seg, h), QColor(sl["scheme"][0]))
        p.restore()

        p.setPen(QPen(QColor("#1e293b"), 1.2))
        p.setBrush(Qt.NoBrush)
        p.drawPath(outline)

        # pembatas antar segmen (disembunyikan di sebelah segmen berwarna)
        for i in range(1, n):
            if self.slots[i - 1]["scheme"] == NEUTRAL_SCHEME and self.slots[i]["scheme"] == NEUTRAL_SCHEME:
                p.setPen(QPen(QColor("#1e293b"), 1))
                p.drawLine(QPointF(i * seg, h * 0.25), QPointF(i * seg, h * 0.75))

        # isi tiap segmen: ikon + judul (+ keterangan di sampingnya bila muat)
        f_t, f_s = font(12, True), font(11, False)
        icon, gap = S(18), S(8)
        for i, sl in enumerate(self.slots):
            bg, fg, _ = sl["scheme"]
            avail = seg - S(28) - icon - gap
            title, sub = sl["title"], sl["sub"]
            tw = text_width(f_t, title)
            if tw > avail:
                title = QFontMetrics(f_t).elidedText(title, Qt.ElideRight, int(avail))
                tw, sub = text_width(f_t, title), ""
            sub_w = 0
            if sub:
                room = avail - tw - S(14)
                if room > S(40):
                    sub = QFontMetrics(f_s).elidedText(sub, Qt.ElideRight, int(room))
                    sub_w = text_width(f_s, sub)
                else:
                    sub = ""
            group_w = icon + gap + tw + ((S(14) + sub_w) if sub else 0)
            x = i * seg + (seg - group_w) / 2
            draw_icon(p, sl["icon"], QRectF(x, (h - icon) / 2, icon, icon), sl["icon_color"], 1.7)
            tx = x + icon + gap
            p.setPen(QColor(fg))
            p.setFont(f_t)
            p.drawText(QRectF(tx, 0, tw + 4, h), Qt.AlignLeft | Qt.AlignVCenter, title)
            if sub:
                c = QColor(fg)
                c.setAlpha(190)
                p.setPen(c)
                p.setFont(f_s)
                p.drawText(QRectF(tx + tw + S(14), 0, sub_w + 4, h), Qt.AlignLeft | Qt.AlignVCenter, sub)


